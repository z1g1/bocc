---
// Event check-in form at /checkin/bocc (the URL in the printed QR codes, with
// ?token=<GUID>). public/js/checkin.js drives it: keep the element IDs, the
// #eventId value and the data-sponsor-* attributes, since the script reads them.
// No analytics on this page. Styles: src/styles/bocc/_checkin.scss.
import Default from "../../layouts/Default.astro";
import { data } from "../../lib/data";
const sponsor = data("sponsor");
---
<Default title="Welcome to BOCC" path="/checkin/bocc" analytics={false}>
  <div class="checkin">
    <h1 id="checkinHeader">Please check in</h1>
    <form id="checkinForm">
      <input type="hidden" id="eventId" value="bocc">

      <div class="form-group">
        <label for="name">Name (required):</label>
        <input type="text" id="name" name="name" required autocomplete="name">
      </div>

      <div class="form-group">
        <label for="email">Email (required):</label>
        <input type="email" id="email" name="email" required autocomplete="email">
      </div>

      <div class="form-group">
        <label for="phone">Phone (optional):</label>
        <input type="tel" id="phone" name="phone" autocomplete="tel">
      </div>

      <div class="form-group">
        <label for="businessName">Business Name (optional):</label>
        <input type="text" id="businessName" name="businessName" autocomplete="organization">
      </div>

      <div class="checkbox-group">
        <input type="checkbox" id="okToEmail" name="okToEmail">
        <label for="okToEmail">Send me updates about future BOCC events</label>
      </div>

      <div class="honeypot-field" aria-hidden="true">
        <label for="website">Leave this field empty</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
      </div>
      <hr aria-hidden="true">
      <p>By checking in, you agree to our <a href="/privacy/">Privacy Policy</a>.</p>
      <button type="submit" id="checkinButton">Check In</button>
      <noscript><p>JavaScript is required for check-in. Please ask a host to check you in manually.</p></noscript>
    </form>

    <div id="greeting" role="status" aria-live="polite" style="display:none;"></div>

    {sponsor.enabled && (
      <div id="sponsorRedirect" style="display:none;"
           data-sponsor-name={sponsor.name}
           data-sponsor-url={sponsor.url}
           data-sponsor-delay={String(sponsor.delay)}></div>
    )}

    <script is:inline src="/js/checkin.js" defer></script>
  </div>
</Default>
