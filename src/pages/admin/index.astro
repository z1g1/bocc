---
// /admin/: landing page for every role. The middleware has already refused anyone
// without a session or a role; this page still names the roles it admits.
//
// The link sections come from src/lib/admin/nav.mjs (homeSectionsFor: ROLE_LINKS with
// ROLE_TITLES), shared with the section nav on every admin page, so a new role needs no
// change here.
import Admin from "../../layouts/Admin.astro";
import { ROLES, hasRole, requireRole } from "../../lib/admin/roles.mjs";
import { longDay } from "../../lib/admin/format.mjs";
import ReadyTag from "../../components/admin/ReadyTag.astro";
import { homeSectionsFor } from "../../lib/admin/nav.mjs";
export const prerender = false;

const denied = requireRole(Astro.locals, ...ROLES);
if (denied) return denied;

const { user, roles = [] } = Astro.locals;
const isAdmin = hasRole(Astro.locals, "admin");
const sections = homeSectionsFor(roles);

// Admin-only events block (plan Phase 3): the next events and the "report missing"
// count, with "today" the Eastern calendar day; Event readiness at a glance (#59); every
// saved event counted by Event status, each count linking to the filtered events list.
let events: { upcoming: any[]; missing: number; counts: Record<string, number>; statuses: readonly string[]; nextTue: string; readiness: Map<string, any>; labels: Record<string, string> } | null = null;
if (isAdmin) {
  const { pool } = await import("../../lib/admin/db.mjs");
  const ev = await import("../../lib/admin/events.mjs");
  const today = ev.todayEastern();
  const [upcoming, missing, counts] = await Promise.all([
    ev.listUpcoming(pool, { today, limit: 2 }),
    ev.reportMissingCount(pool, { today }),
    ev.statusCounts(pool),
  ]);
  const { eventReadinessByDate } = await import("../../lib/admin/event-readiness-load.mjs");
  const readiness = await eventReadinessByDate(pool, upcoming);
  events = { upcoming, missing, counts, statuses: ev.STATUSES, nextTue: ev.nextTuesday(today), readiness, labels: ev.STATUS_LABELS };
}
const statusText = (s: string) => (events!.labels[s] ?? events!.labels.scheduled).toLowerCase();
---
<Admin title="Home" user={user} roles={roles}>
  <h1>Hello, {user!.name}</h1>

  {events && (
    <section>
      <h2>Events</h2>
      {events.missing > 0 && (
        <p><a class="missing" href="/admin/events/?missing=1"><strong>{events.missing} report{events.missing === 1 ? "" : "s"} missing</strong></a></p>
      )}
      {events.upcoming.length > 0
        ? <ul>{events.upcoming.map((e) => <li>Next: <a href={`/admin/events/${e.date}/`}>{longDay(e.date)}</a> <span class="muted">{statusText(e.status)}</span> <ReadyTag tag={events!.readiness.get(e.date)?.tag} /></li>)}</ul>
        : <p class="muted">No upcoming events saved. <a href={`/admin/events/${events.nextTue}/`}>Open next Tuesday ({longDay(events.nextTue)})</a></p>}
      <p class="counts">All saved events: {events.statuses.map((st, i) => <>{i > 0 && " · "}<a href={`/admin/events/?status=${st}`}>{events!.labels[st]} {events!.counts[st]}</a></>)}</p>
    </section>
  )}

  {sections.map((s) => (
    <section>
      <h2>{s.title}</h2>
      <ul>{s.links.map((l) => <li><a href={l.href}>{l.label}</a>{l.note && <span class="muted"> {l.note}</span>}</li>)}</ul>
    </section>
  ))}

  <p><a href="/admin/account/">Your account</a>: add a passkey for this device.</p>
</Admin>

<style>
  .missing { color: var(--err); }
</style>
