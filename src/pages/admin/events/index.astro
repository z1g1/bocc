---
// /admin/events/: upcoming events and past events (ADR 0009, plan Phase 3). Admin only.
// "Today" is the Eastern calendar day. A past date still `scheduled` is flagged
// "report missing". The past list is paged (?page=N, 25 a page); ?missing=1 shows only
// the report-missing ones. ?status=scheduled|reported|cancelled filters both lists by
// Event status (anything else is no filter). ?date=YYYY-MM-DD (the "open a date" GET form, no script)
// redirects to /admin/events/YYYY-MM-DD/. Upcoming events show their Event readiness at a
// glance (ReadyTag, #59).
import Admin from "../../../layouts/Admin.astro";
import { requireRole } from "../../../lib/admin/roles.mjs";
import { longDay } from "../../../lib/admin/format.mjs";
import ReadyTag from "../../../components/admin/ReadyTag.astro";
export const prerender = false;

const denied = requireRole(Astro.locals, "admin");
if (denied) return denied;

const { user, roles = [] } = Astro.locals;
const ev = await import("../../../lib/admin/events.mjs");

const requested = Astro.url.searchParams.get("date");
if (requested !== null && ev.parseDate(requested.trim())) {
  return Astro.redirect(`/admin/events/${requested.trim()}/`, 303);
}

const { pool } = await import("../../../lib/admin/db.mjs");
const PER_PAGE = 25;
const today = ev.todayEastern();
const missingOnly = Astro.url.searchParams.get("missing") === "1";
const status = ev.parseStatusFilter(Astro.url.searchParams.get("status"));
const page = Math.max(1, Math.min(1000, Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1));
const [upcoming, past, missingCount] = await Promise.all([
  ev.listUpcoming(pool, { today, status }),
  ev.listPast(pool, { today, limit: PER_PAGE, offset: (page - 1) * PER_PAGE, missingOnly, status }),
  ev.reportMissingCount(pool, { today }),
]);
const { eventReadinessByDate } = await import("../../../lib/admin/event-readiness-load.mjs");
const readiness = await eventReadinessByDate(pool, upcoming);
const pages = Math.max(1, Math.ceil(past.total / PER_PAGE));
const pageHref = (p: number) => `/admin/events/?${missingOnly ? "missing=1&" : ""}${status ? `status=${status}&` : ""}page=${p}`;
const nextTue = ev.nextTuesday(today);
const LOC: Record<string, string> = ev.LOCATIONS;
const where = (e: any) => (e.location === "other" ? e.locationOther : e.location ? LOC[e.location] : "");
const STATUS_LABELS: Record<string, string> = ev.STATUS_LABELS;
const statusText = (e: any) => STATUS_LABELS[e.status] ?? STATUS_LABELS.scheduled;
const yesNo = (b: boolean | null | undefined) => (b == null ? "" : b ? "Yes" : "No");
---
<Admin title="Events" user={user} roles={roles} wide>
  <h1>Events</h1>

  <form method="get" class="filters">
    <label for="date">Open a date</label>
    <input id="date" name="date" type="date" required value={nextTue}>
    <button type="submit">Open</button>
  </form>
  {requested !== null && <p class="error" role="alert">“{requested}” is not a date (YYYY-MM-DD).</p>}

  <nav class="status-filter" aria-label="Filter by status">
    Show:
    <a href="/admin/events/" aria-current={status === null && !missingOnly ? "true" : undefined}>All</a>
    {ev.STATUSES.map((st: string) => (
      <a href={`/admin/events/?status=${st}`} aria-current={status === st ? "true" : undefined}>{STATUS_LABELS[st]}</a>
    ))}
  </nav>

  <h2>Upcoming</h2>
  {upcoming.length === 0
    ? status
      ? <p class="muted">No upcoming {STATUS_LABELS[status]} events.</p>
      : <p class="muted">No upcoming events saved yet. <a href={`/admin/events/${nextTue}/`}>Open next Tuesday ({longDay(nextTue)})</a>.</p>
    : (
      <ul>
        {upcoming.map((e: any) => (
          <li>
            <a href={`/admin/events/${e.date}/`}>{longDay(e.date)}</a>
            {e.date === today && <span class="tag">today</span>}
            <span class="muted"> {statusText(e)}{where(e) && ` · ${where(e)}`}</span>
            <ReadyTag tag={readiness.get(e.date)?.tag} />
          </li>
        ))}
      </ul>
    )}

  <h2>Past</h2>
  <p>
    {missingCount === 0
      ? <span class="muted">No reports missing.</span>
      : <strong class="missing">{missingCount} report{missingCount === 1 ? "" : "s"} missing</strong>}
    {missingOnly
      ? <> · <a href="/admin/events/">Show all past events</a></>
      : missingCount > 0 && <> · <a href="/admin/events/?missing=1">Show only those</a></>}
  </p>
  {past.rows.length === 0
    ? <p class="muted">None.</p>
    : (
      <div class="scroll">
        <table class="data">
          <thead><tr><th>Date</th><th>Status</th><th>Location</th><th class="num">Attendee count</th><th class="num">Check-in count</th><th>Bling</th></tr></thead>
          <tbody>
            {past.rows.map((e: any) => (
              <tr>
                <td><a href={`/admin/events/${e.date}/`}>{longDay(e.date)}</a></td>
                <td>{e.reportMissing ? <strong class="missing">Report missing</strong> : statusText(e)}</td>
                <td>{where(e)}</td>
                <td class="num">{e.report?.attendeeCount ?? ""}</td>
                <td class="num">{e.checkinCount || ""}</td>
                <td>{yesNo(e.report?.blingGiven)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  {pages > 1 && (
    <p class="pager">
      {page > 1 && <a href={pageHref(page - 1)}>← Newer</a>}
      <span class="muted">Page {page} of {pages}</span>
      {page < pages && <a href={pageHref(page + 1)}>Older →</a>}
    </p>
  )}
  <p class="muted">“Attendee count” is the official attendance, counted in the room. “Check-in count” counts the check-in form (Debug check-ins left out). It is not attendance: not everyone checks in.</p>
</Admin>

<style>
  .missing { color: var(--err); }
  .pager { display: flex; gap: 1rem; }
  .status-filter { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-block: 0.5rem 1rem; }
  .status-filter [aria-current] { font-weight: bold; text-decoration: none; }
</style>
