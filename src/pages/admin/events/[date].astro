---
// /admin/events/YYYY-MM-DD/: one event day (ADR 0009, plan Phase 3). Admin only.
// Status and location, the listings and readiness checklist (Phase 4), the social
// post (SocialPost, Phase 5, ADR 0011), the cancel flow, the after-event report (it
// replaces the Google Form) and the photos (EventMedia, ADR 0010).
//
// A date with no events row still renders, as a new scheduled event; the first save
// of any form creates the row. Plain HTML forms, no client script: each POSTs back
// here with an `action` field, is Origin-checked, and answers 303 to a GET with a
// fixed ?notice= (post/redirect/get). Invalid input re-renders with 400 (409 for a
// refused state change) and the messages next to the fields. All logic and the audit
// rows are in src/lib/admin/events.mjs, event-links.mjs and social.mjs. The social
// post's video upload is the one part that needs JavaScript (/js/admin-video.js).
//
// Every save that changed something purges the public /events/<date>/ page from the
// CDN (social post saves only when they created the events row: the public page
// doesn't show them) (src/lib/site/purge.mjs). It is awaited so it runs before the function ends, but
// it never throws, and a failure is caught here: the save is already committed.
import Admin from "../../../layouts/Admin.astro";
import EventMedia from "../../../components/admin/EventMedia.astro";
import SocialPost from "../../../components/admin/SocialPost.astro";
import { requireRole } from "../../../lib/admin/roles.mjs";
import { checkOrigin } from "../../../lib/admin/csrf.mjs";
import { easternDateTime, longDay } from "../../../lib/admin/format.mjs";
import { purgeEventPages } from "../../../lib/site/purge.mjs";
import { log } from "../../../lib/telemetry.mjs";
export const prerender = false;

const denied = requireRole(Astro.locals, "admin");
if (denied) return denied;

const { user, roles = [] } = Astro.locals;
const ev = await import("../../../lib/admin/events.mjs");
const el = await import("../../../lib/admin/event-links.mjs");
const so = await import("../../../lib/admin/social.mjs");
const { CANCEL_REASONS, LIMITS, LOCATIONS } = ev;

const notFound = () => new Response("Not a date", { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } });
const date = ev.parseDate(Astro.params.date ?? "");
if (!date) return notFound();

const NOTICES: Record<string, string> = {
  saved: "Saved.",
  cancelled: "Event cancelled.",
  uncancelled: "Event un-cancelled. It is scheduled again.",
  report: "Report saved. The event is marked held.",
  link: "Listing saved.",
  unlink: "Listing cleared.",
  social_post: "Social post saved.",
  social_video: "Promo video attached to the social post.",
  social_channel: "Channel text saved.",
  unchanged: "Nothing changed.",
};
const ACTIONS: Record<string, (actor: string, d: string, input: Record<string, string>) => Promise<{ changed: boolean; eventCreated?: boolean }>> = {
  save: ev.saveEvent,
  cancel: ev.cancelEvent,
  uncancel: (actor, d) => ev.uncancelEvent(actor, d),
  report: ev.submitReport,
  link: (actor, d, input) => el.setLink(actor, d, input.platform, input),
  unlink: (actor, d, input) => el.clearLink(actor, d, input.platform),
  social_post: (actor, d, input) => so.savePost(actor, d, input),
  social_video: (actor, d, input) => so.setVideo(actor, d, input.videoMediaId),
  social_channel: (actor, d, input) => so.saveChannel(actor, d, input.channel, input),
};
const SOCIAL = new Set(["social_post", "social_video", "social_channel"]);
const DONE: Record<string, string> = {
  save: "saved", cancel: "cancelled", uncancel: "uncancelled", report: "report", link: "link", unlink: "unlink",
  social_post: "social_post", social_video: "social_video", social_channel: "social_channel",
};

let errors: Record<string, string> = {};
let posted: { action: string; values: Record<string, string> } | null = null;

if (Astro.request.method === "POST") {
  const refused = checkOrigin(Astro.request);
  if (refused) return refused;
  let data: FormData;
  try {
    data = await Astro.request.formData();
  } catch {
    return new Response("Bad Request", { status: 400, headers: { "content-type": "text/plain; charset=utf-8" } });
  }
  const action = String(data.get("action") ?? "");
  const run = ACTIONS[action];
  if (!run) return new Response("Bad Request: unknown action", { status: 400, headers: { "content-type": "text/plain; charset=utf-8" } });
  const values: Record<string, string> = {};
  for (const [k, v] of data) if (typeof v === "string") values[k] = v;
  try {
    const { changed, eventCreated } = await run(user!.id, date, values);
    if (changed && (!SOCIAL.has(action) || eventCreated)) {
      try {
        await purgeEventPages([date], { locals: Astro.locals });
      } catch (err) {
        log("error", "event page purge failed", { date, error: String(err) });
      }
    }
    const anchor = SOCIAL.has(action) ? "#social" : "";
    return Astro.redirect(`/admin/events/${date}/?notice=${changed ? DONE[action] : "unchanged"}${anchor}`, 303);
  } catch (err: any) {
    if (!(err instanceof ev.ValidationError)) throw err;
    errors = (err as any).errors;
    posted = { action, values };
    Astro.response.status = err.status;
  }
} else if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") {
  return new Response("Method Not Allowed", { status: 405, headers: { allow: "GET, POST" } });
}

const { pool } = await import("../../../lib/admin/db.mjs");
const [event, links, social] = await Promise.all([ev.getEvent(pool, date), el.getLinks(pool, date), so.getWorkOrder(pool, date)]);
const today = ev.todayEastern();
const upcoming = date >= today;
const ready = el.readiness(event, links, social);
const isFuture = date > today;
const missing = ev.isReportMissing(event, today);
const notice = posted ? null : NOTICES[Astro.url.searchParams.get("notice") ?? ""] ?? null;

// Form values: what was just posted (on an error), else what is stored.
const from = (action: string) => (posted?.action === action ? posted.values : null);
const det = from("save") ?? {
  status: event.status === "cancelled" ? "" : event.status,
  location: event.location ?? "",
  locationOther: event.locationOther ?? "",
};
const can = from("cancel") ?? {
  cancelReason: event.cancelReason ?? "",
  cancelReasonOther: event.cancelReasonOther ?? "",
  cancelAnnounced: event.cancelAnnounced ? "on" : "",
};
const r = event.report;
const rep = from("report") ?? {
  givesAsksCount: r?.givesAsksCount == null ? "" : String(r.givesAsksCount),
  notes: r?.notes ?? "",
  blingGiven: r?.blingGiven == null ? "" : r.blingGiven ? "yes" : "no",
  blingDetails: r?.blingDetails ?? "",
};
const errFor = (action: string) => (posted?.action === action ? errors : {});
const detErr = errFor("save");
const canErr = errFor("cancel");
const repErr = errFor("report");
const SOURCES: Record<string, string> = { admin: "the admin", google_form: "the Google Form import", pre_form: "the pre-Form history import" };
// Listings: the posted values (on an error) for that platform's row, else what is stored.
const linkPosted = (p: string) => (posted && (posted.action === "link" || posted.action === "unlink") && posted.values.platform === p ? posted : null);
const linkVal = (p: string) => {
  const lp = linkPosted(p);
  return lp?.action === "link"
    ? { url: lp.values.url ?? "", externalId: lp.values.externalId ?? "" }
    : { url: links[p]?.url ?? "", externalId: links[p]?.externalId ?? "" };
};
const linkErr = (p: string) => (linkPosted(p) ? errors : {});
const mark = (ok: boolean | null) => (ok === null ? "–" : ok ? "✓" : "✗");
const statusLabel = event.status === "cancelled" ? "Cancelled" : event.status === "held" ? "Held" : "Scheduled";
---
<Admin title={`Event ${date}`} user={user} roles={roles}>
  <p><a href="/admin/events/">← Events</a></p>
  <h1>{longDay(date)}</h1>
  <p class="status">
    <span class={`badge ${event.status}`}>{statusLabel}</span>
    {missing && <span class="badge missing">Report missing</span>}
    {!event.exists && <span class="muted"> Not saved yet: the first save creates this event.</span>}
  </p>
  {notice && <p class="notice" role="status">{notice}</p>}
  {posted && errors.date && <p class="error" role="alert">{errors.date}</p>}
  {posted && errors.platform && <p class="error" role="alert">{errors.platform}</p>}
  {posted && errors.channel && <p class="error" role="alert">{errors.channel}</p>}

  {upcoming && (
    <section aria-labelledby="h-ready" class="ready">
      <h2 id="h-ready">Readiness <span class="muted">{ready.listings}/{ready.total} listings{ready.social.exists && <> · {ready.social.scheduled}/{ready.social.total} channels scheduled</>}</span></h2>
      <ul class="checklist">
        {ready.items.map((i) => (
          <li class={i.ok === null ? "later" : i.ok ? "ok" : "todo"}>
            <span class="mark" aria-hidden="true">{mark(i.ok)}</span>
            {i.href ? <a href={i.href} target="_blank" rel="noopener">{i.label}</a> : i.label}
            <span class="visually-hidden">{i.ok === null ? " (not yet)" : i.ok ? " (done)" : " (missing)"}</span>
            {i.note && <span class="muted"> · {i.note}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="h-details">
    <h2 id="h-details">Status and location</h2>
    <form method="post" class="narrow">
      <input type="hidden" name="action" value="save">
      {event.status === "cancelled"
        ? <p class="muted">Status: cancelled. Un-cancel below to change it.</p>
        : (
          <fieldset>
            <legend>Status</legend>
            <label class="check"><input type="radio" name="status" value="scheduled" checked={det.status === "scheduled"}> Scheduled</label>
            <label class="check"><input type="radio" name="status" value="held" checked={det.status === "held"}> Held</label>
            {detErr.status && <p class="error" role="alert">{detErr.status}</p>}
          </fieldset>
        )}
      <fieldset>
        <legend>Location</legend>
        <label class="check"><input type="radio" name="location" value="" checked={det.location === ""}> Not set</label>
        {Object.entries(LOCATIONS).map(([v, label]) => (
          <label class="check"><input type="radio" name="location" value={v} checked={det.location === v}> {label}</label>
        ))}
        {detErr.location && <p class="error" role="alert">{detErr.location}</p>}
        <label for="locationOther">Where, if Other</label>
        <input id="locationOther" name="locationOther" maxlength={LIMITS.locationOther} value={det.locationOther}
          aria-invalid={detErr.locationOther ? "true" : undefined}>
        {detErr.locationOther && <p class="error" role="alert">{detErr.locationOther}</p>}
      </fieldset>
      <button type="submit">Save status and location</button>
    </form>
  </section>

  <section aria-labelledby="h-links">
    <h2 id="h-links">Listings</h2>
    <p class="muted">The event on each platform. Luma is the public page's call to action; the others are listed for search engines.</p>
    {el.PLATFORM_KEYS.map((p) => {
      const v = linkVal(p);
      const e = linkErr(p);
      const stored = links[p];
      return (
        <form method="post" class="link-row" id={`link-${p}`}>
          <input type="hidden" name="platform" value={p}>
          <label for={`url-${p}`}>{el.PLATFORMS[p]}</label>
          {stored
            ? <p class="current"><a href={stored.url} target="_blank" rel="noopener">{stored.url}</a></p>
            : <p class="current muted">Not listed yet.</p>}
          <input id={`url-${p}`} name="url" type="text" inputmode="url" autocomplete="off" spellcheck="false" maxlength={el.URL_MAX} value={v.url}
            placeholder={p === "luma" ? "https://luma.com/…" : p === "eventbrite" ? "https://www.eventbrite.com/e/…" : p === "facebook_event" ? "https://www.facebook.com/events/…" : "https://www.linkedin.com/events/…"}
            aria-invalid={e.url ? "true" : undefined}>
          {e.url && <p class="error" role="alert">{e.url}</p>}
          {p === "luma" && (
            <>
              <label for="externalId-luma">Luma event id <span class="muted">(evt-…, from the embed code; needed for the RSVP embed)</span></label>
              <input id="externalId-luma" name="externalId" maxlength="100" value={v.externalId} pattern="evt-[A-Za-z0-9_\-]+"
                aria-invalid={e.externalId ? "true" : undefined}>
              {e.externalId && <p class="error" role="alert">{e.externalId}</p>}
            </>
          )}
          <div class="buttons">
            <button type="submit" name="action" value="link">Save {el.PLATFORMS[p]}</button>
            {stored && <button type="submit" name="action" value="unlink" class="secondary">Clear</button>}
          </div>
        </form>
      );
    })}
  </section>

  <SocialPost date={date} order={social} posted={posted && SOCIAL.has(posted.action) ? posted : null} errors={errors} />

  <section aria-labelledby="h-report">
    <h2 id="h-report">Report</h2>
    {r && (
      <p class="muted">
        From {SOURCES[r.source] ?? r.source}{r.by && <> ({r.by})</>}, last saved {easternDateTime(r.updatedAt)}.
      </p>
    )}
    {event.status === "cancelled"
      ? <p class="muted">No report for a cancelled event. Un-cancel it first if it went ahead.</p>
      : isFuture
        ? <p class="muted">The report opens on the day of the event.</p>
        : (
          <form method="post" class="narrow">
            <input type="hidden" name="action" value="report">
            <label for="givesAsksCount">People counted at Gives and Asks</label>
            <div class="count-row">
              <input id="givesAsksCount" name="givesAsksCount" type="number" inputmode="numeric" min="0" max={LIMITS.givesAsks} step="1"
                required value={rep.givesAsksCount} aria-invalid={repErr.givesAsksCount ? "true" : undefined} aria-describedby="checkin-note">
              <p id="checkin-note" class="checkins">
                <strong>{event.checkinCount}</strong> checked in on the form
                <span class="muted">(not attendance: not everyone checks in; test check-ins left out)</span>
                {event.checkinCount > 0 && <> · <a href={`/admin/checkins/?date=${date}`}>who</a></>}
              </p>
            </div>
            {repErr.givesAsksCount && <p class="error" role="alert">{repErr.givesAsksCount}</p>}

            <fieldset>
              <legend>Bring a Friend Bling given out?</legend>
              <label class="check"><input type="radio" name="blingGiven" value="yes" checked={rep.blingGiven === "yes"} required> Yes</label>
              <label class="check"><input type="radio" name="blingGiven" value="no" checked={rep.blingGiven === "no"}> No</label>
              {repErr.blingGiven && <p class="error" role="alert">{repErr.blingGiven}</p>}
            </fieldset>
            <label for="blingDetails">Bling details, if given <span class="muted">(who got it, who they brought)</span></label>
            <textarea id="blingDetails" name="blingDetails" rows="2" maxlength={LIMITS.blingDetails}
              aria-invalid={repErr.blingDetails ? "true" : undefined}>{rep.blingDetails}</textarea>
            {repErr.blingDetails && <p class="error" role="alert">{repErr.blingDetails}</p>}

            <label for="notes">Notes and feedback</label>
            <textarea id="notes" name="notes" rows="4" maxlength={LIMITS.notes}
              aria-invalid={repErr.notes ? "true" : undefined}>{rep.notes}</textarea>
            {repErr.notes && <p class="error" role="alert">{repErr.notes}</p>}
            <button type="submit">{r ? "Update report" : "Submit report"}</button>
          </form>
        )}
  </section>

  <section aria-labelledby="h-cancel">
    <h2 id="h-cancel">{event.status === "cancelled" ? "Cancelled" : "Cancel this event"}</h2>
    {r && event.status !== "cancelled"
      ? <p class="muted">This event has a report, so it was held.</p>
      : (
        <form method="post" class="narrow">
          <input type="hidden" name="action" value="cancel">
          <fieldset>
            <legend>Why?</legend>
            {Object.entries(CANCEL_REASONS).map(([v, label]) => (
              <label class="check"><input type="radio" name="cancelReason" value={v} checked={can.cancelReason === v} required> {label}</label>
            ))}
            {canErr.cancelReason && <p class="error" role="alert">{canErr.cancelReason}</p>}
            <label for="cancelReasonOther">Reason, if Other</label>
            <input id="cancelReasonOther" name="cancelReasonOther" maxlength={LIMITS.cancelReasonOther} value={can.cancelReasonOther}
              aria-invalid={canErr.cancelReasonOther ? "true" : undefined}>
            {canErr.cancelReasonOther && <p class="error" role="alert">{canErr.cancelReasonOther}</p>}
          </fieldset>
          <label class="check"><input type="checkbox" name="cancelAnnounced" value="on" checked={can.cancelAnnounced === "on"}> Announced on all socials</label>
          <button type="submit" class={event.status === "cancelled" ? undefined : "secondary"}>
            {event.status === "cancelled" ? "Save cancellation" : "Cancel event"}
          </button>
        </form>
      )}
    {event.status === "cancelled" && (
      <form method="post">
        <input type="hidden" name="action" value="uncancel">
        <button type="submit" class="secondary">Un-cancel (back to scheduled)</button>
      </form>
    )}
  </section>

  <EventMedia date={date} />
</Admin>

<style>
  section { margin-top: 2rem; }
  fieldset { border: 0; padding: 0; margin: 0.75rem 0 0; }
  legend { font-weight: 600; padding: 0; }
  textarea { width: 100%; padding: 0.6rem; font: inherit; border: 1px solid var(--line); border-radius: 6px; background: transparent; color: inherit; }
  .count-row { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; }
  .count-row input { width: 8rem; }
  .checkins { margin: 0; }
  .badge { display: inline-block; padding: 0.1rem 0.5rem; border: 1px solid var(--line); border-radius: 4px; font-weight: 600; }
  .badge.cancelled, .badge.missing { color: var(--err); border-color: var(--err); }
  .badge.held { color: var(--accent); border-color: var(--accent); }
  .ready { margin-top: 1rem; padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: 6px; }
  .ready h2 { margin: 0; font-size: 1rem; }
  .checklist { list-style: none; padding: 0; margin: 0.25rem 0 0; display: flex; flex-wrap: wrap; gap: 0.15rem 1.25rem; }
  .checklist .mark { display: inline-block; width: 1.1em; font-weight: 700; }
  .checklist .ok .mark { color: var(--accent); }
  .checklist .todo .mark { color: var(--err); }
  .checklist .later { opacity: 0.55; }
  .link-row { margin: 1rem 0 0; padding-top: 0.75rem; border-top: 1px solid var(--line); max-width: 40rem; }
  .link-row label:first-of-type { font-weight: 600; }
  .link-row .current { margin: 0.1rem 0 0.35rem; overflow-wrap: anywhere; }
  .link-row input { width: 100%; }
  .link-row .buttons { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
