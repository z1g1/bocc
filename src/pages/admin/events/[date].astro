---
// /admin/events/YYYY-MM-DD/: one event day (ADR 0009, plan Phase 3). Admin only.
// Two sections, Event readiness and Social plan readiness (#59; src/lib/admin/event-readiness.mjs,
// social-plan-readiness.mjs), shown for today and Upcoming Events, sit above three tabs
// (ADR 0012 decision 1):
//   ?tab=info    Event Info: status (scheduled, reported or cancelled, with the cancel reason
//                fields shown only while Cancelled is selected) and location in one form;
//                below it, for a cancelled event that was posted on LinkedIn, the red
//                "Cancel the LinkedIn event on LinkedIn" item and its "Done on LinkedIn"
//                form (action linkedin_cancel_done, #27); the Online Event Listings; the
//                Event Image (EventImage, ADR 0012 decision 3); then the LinkedIn event
//                section (ADR 0012, #38: made Tuesday afternoon for the next week's
//                event, alongside the other listings): the Admin's own LinkedIn
//                authentication (LinkedInAuthentication, posting to /api/admin/linkedin/*) and
//                the event's preview, dialog, dry run and live create with its
//                recovery (LinkedInEvent; actions linkedin_create, linkedin_publish,
//                linkedin_allow_retry: 303 once posted or retired, else rendered
//                without a redirect, 409 when refused, 502 when a LinkedIn step failed),
//                and the "LinkedIn is out of date…" notice when the location or Event
//                Image changed after it was posted (#27: flagged, not synced). Once a
//                LinkedIn listing URL is saved, a "Listed:" link (noting when it was
//                created manually outside the app) and the authentication and create
//                tools folded in a <details>
//   ?tab=social  Social plan: the Event's Social plan and its social media posts
//                (SocialPlan, Phase 5, ADR 0011)
//   ?tab=post    Post Event: the after-event report (it replaces the Google Form), the
//                Luma sync (LumaSyncSection, ADR 0014, #75: status, Error note, everyone
//                who joined the Email list at the Event, and the Admin's "Mark Done
//                (handled by hand)", action luma_sync_done; 409 for a Cancelled,
//                Upcoming or pre-launch Event, 404 when the date is not an Event) and
//                the photos (EventMedia, ADR 0010: Sign-in board, Photos from Event)
// The tabs are plain links and only the current tab is rendered, so they work without
// JavaScript. No tab, or an unknown one: Event Info for a future date, Post Event for
// today or earlier, in Eastern time (src/lib/admin/event-tabs.mjs).
//
// A date with no events row still renders, as a new scheduled event; the first save
// of any form creates the row. Plain HTML forms, no client script: each POSTs back
// here with an `action` field, is Origin-checked, and answers 303 to a GET with a
// fixed ?notice= on the tab the form lives on (ACTION_TABS; post/redirect/get). Invalid
// input re-renders that tab with 400 (409 for a refused state change) and the messages
// next to the fields. All logic and the audit
// rows are in src/lib/admin/events.mjs, event-links.mjs and social-plan.mjs. The Social
// plan's video upload is the one part that needs JavaScript (/js/admin-video.js).
//
// Every save that changed something purges the public /events/<date>/ page from the
// CDN (Social plan saves only when they created the events row: the public page
// doesn't show them) (src/lib/site/purge.mjs). It is awaited so it runs before the function ends, but
// it never throws, and a failure is caught here: the save is already committed.
import { eventReadiness } from "../../../lib/admin/event-readiness.mjs";
import { socialPlanReadiness } from "../../../lib/admin/social-plan-readiness.mjs";
import Admin from "../../../layouts/Admin.astro";
import EventImage from "../../../components/admin/EventImage.astro";
import EventMedia from "../../../components/admin/EventMedia.astro";
import SocialPlan from "../../../components/admin/SocialPlan.astro";
import LinkedInAuthentication from "../../../components/admin/LinkedInAuthentication.astro";
import LinkedInEvent from "../../../components/admin/LinkedInEvent.astro";
import LumaSyncSection from "../../../components/admin/LumaSyncSection.astro";
import { requireRole } from "../../../lib/admin/roles.mjs";
import { checkOrigin } from "../../../lib/admin/csrf.mjs";
import { easternDateTime, longDay } from "../../../lib/admin/format.mjs";
import { ACTION_TABS, LINKEDIN_TAB, TABS, pickTab } from "../../../lib/admin/event-tabs.mjs";
import { purgeEventPages } from "../../../lib/site/purge.mjs";
import { log } from "../../../lib/telemetry.mjs";
export const prerender = false;

const denied = requireRole(Astro.locals, "admin");
if (denied) return denied;

const { user, roles = [] } = Astro.locals;
const ev = await import("../../../lib/admin/events.mjs");
const el = await import("../../../lib/admin/event-links.mjs");
const so = await import("../../../lib/admin/social-plan.mjs");
const eim = await import("../../../lib/admin/event-image.mjs");
const { CANCEL_REASONS, LIMITS, LOCATIONS } = ev;
const STATUS_LABELS: Record<string, string> = ev.STATUS_LABELS;

const notFound = () => new Response("Not a date", { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } });
const date = ev.parseDate(Astro.params.date ?? "");
if (!date) return notFound();

const NOTICES: Record<string, string> = {
  saved: "Saved.",
  report: "Report saved. The event is marked Reported.",
  link: "Listing saved.",
  unlink: "Listing cleared.",
  social_plan: "Social plan saved.",
  social_video: "Promo video attached to the Social plan.",
  social_thumbnail: "Thumbnail saved.",
  social_media_post: "Social media post text saved.",
  linkedin_posted: "LinkedIn event created and its LinkedIn post published.",
  linkedin_retry: "The pending LinkedIn create was cleared: you can create the event again.",
  linkedin_cancel_done: "Marked as cancelled on LinkedIn.",
  luma_sync_done: "Luma sync marked Done. Everyone listed is now On Luma.",
  unchanged: "Nothing changed.",
};
const LINKEDIN_ACTIONS = new Set(["linkedin_create", "linkedin_publish", "linkedin_allow_retry"]);
const ACTIONS: Record<string, (actor: string, d: string, input: Record<string, string>) => Promise<{ changed: boolean; eventCreated?: boolean }>> = {
  save: ev.saveEvent,
  report: ev.submitReport,
  link: (actor, d, input) => el.setLink(actor, d, input.platform, input),
  unlink: (actor, d, input) => el.clearLink(actor, d, input.platform),
  social_plan: (actor, d, input) => so.savePlan(actor, d, input),
  social_video: (actor, d, input) => so.setVideo(actor, d, input.videoMediaId),
  social_thumbnail: (actor, d, input) => so.setThumbnail(actor, d, input.mediaId ?? ""),
  social_media_post: (actor, d, input) => so.saveSocialMediaPost(actor, d, input.channel, input),
  linkedin_cancel_done: async (actor, d) => (await import("../../../lib/linkedin/linkedin.mjs")).markCancelledOnLinkedIn(actor, d),
  // The Admin's manual Done: everyone still in the sync's list is marked On Luma.
  luma_sync_done: async (actor, d) => {
    const ls = await import("../../../lib/admin/luma-sync.mjs");
    try {
      await ls.markDone(actor, d);
    } catch (err: any) {
      if (!(err instanceof ls.NotFoundError)) throw err;
      throw Object.assign(new ev.ValidationError({ date: err.message }), { status: 404 });
    }
    return { changed: true };
  },
};
// Saves the public page doesn't show: no purge.
const NO_PURGE = new Set(["linkedin_cancel_done", "luma_sync_done"]);
const SOCIAL = new Set(["social_plan", "social_video", "social_thumbnail", "social_media_post"]);
// Where a social form's redirect lands: its own block, else the section.
const ANCHORS: Record<string, string> = { social_thumbnail: "#social-thumbnail", linkedin_cancel_done: "#linkedin-cancel", luma_sync_done: "#luma-sync" };
const DONE: Record<string, string> = {
  save: "saved", report: "report", link: "link", unlink: "unlink",
  social_plan: "social_plan", social_video: "social_video", social_thumbnail: "social_thumbnail", social_media_post: "social_media_post",
  linkedin_cancel_done: "linkedin_cancel_done", luma_sync_done: "luma_sync_done",
};

// Purge the public page; a failure is logged, never fails the save.
async function purge() {
  try {
    await purgeEventPages([date!], { locals: Astro.locals });
  } catch (err) {
    log("error", "event page purge failed", { date, error: String(err) });
  }
}

let errors: Record<string, string> = {};
let posted: { action: string; values: Record<string, string> } | null = null;
let linkedInResult: any = null;

if (Astro.request.method === "POST") {
  const refused = checkOrigin(Astro.request);
  if (refused) return refused;
  let data: FormData;
  try {
    data = await Astro.request.formData();
  } catch {
    return new Response("Bad Request", { status: 400, headers: { "content-type": "text/plain; charset=utf-8" } });
  }
  const rawAction = String(data.get("action") ?? "");
  // DEPRECATED: a tab opened before #57 still posts `social_cover` (now social_thumbnail). #60 drops it.
  const action = rawAction === "social_cover" ? "social_thumbnail" : rawAction;
  const run = ACTIONS[action];
  if (LINKEDIN_ACTIONS.has(action)) {
    // A live success that reached `posted`, and allow-retry, 303 back to the section
    // (post/redirect/get). Anything else renders straight away: a dry run changes
    // nothing and its result (the requests that would have been sent) only exists in
    // this response; a refusal is 409, a failed LinkedIn step 502 with the ledger left
    // in its last committed state and the matching recovery shown.
    const li = await import("../../../lib/linkedin/linkedin.mjs");
    const env = li.linkedInEnv();
    if (!env.enabled) return new Response(env.message, { status: 503, headers: { "content-type": "text/plain; charset=utf-8" } });
    const confirm = String(data.get("confirm") ?? "");
    if (action === "linkedin_create") {
      const { getStorage } = await import("../../../lib/admin/storage.mjs");
      linkedInResult = await li.createLinkedInEvent(user!.id, date, { confirm }, { storage: getStorage().storage });
    } else if (action === "linkedin_publish") {
      linkedInResult = await li.publishRetry(user!.id, date, { confirm });
    } else {
      linkedInResult = await li.allowRetry(user!.id, date);
      if (linkedInResult.ok) return Astro.redirect(`/admin/events/${date}/?tab=${LINKEDIN_TAB}&notice=linkedin_retry#linkedin-event`, 303);
    }
    if (linkedInResult.ok && linkedInResult.status === "posted") {
      // The linkedin_event listing was filled: the public page shows listings.
      await purge();
      return Astro.redirect(`/admin/events/${date}/?tab=${LINKEDIN_TAB}&notice=linkedin_posted#linkedin-event`, 303);
    }
    posted = { action, values: {} };
    Astro.response.status = linkedInResult.ok ? 200 : linkedInResult.failure ? 502 : 409;
  } else if (!run) {
    return new Response("Bad Request: unknown action", { status: 400, headers: { "content-type": "text/plain; charset=utf-8" } });
  } else {
  const values: Record<string, string> = {};
  for (const [k, v] of data) if (typeof v === "string") values[k] = v;
  try {
    const { changed, eventCreated } = await run(user!.id, date, values);
    if (changed && !NO_PURGE.has(action) && (!SOCIAL.has(action) || eventCreated)) await purge();
    const anchor = ANCHORS[action] ?? (SOCIAL.has(action) ? "#social" : "");
    return Astro.redirect(`/admin/events/${date}/?tab=${ACTION_TABS[action]}&notice=${changed ? DONE[action] : "unchanged"}${anchor}`, 303);
  } catch (err: any) {
    if (!(err instanceof ev.ValidationError)) throw err;
    errors = (err as any).errors;
    posted = { action, values };
    Astro.response.status = err.status;
  }
  }
} else if (Astro.request.method !== "GET" && Astro.request.method !== "HEAD") {
  return new Response("Method Not Allowed", { status: 405, headers: { allow: "GET, POST" } });
}

const { pool } = await import("../../../lib/admin/db.mjs");
const [event, links, social, eventImage] = await Promise.all([
  ev.getEvent(pool, date), el.getLinks(pool, date), so.getWorkOrder(pool, date), eim.getEventImage(pool, date),
]);
const { linkedInFollowUpFor } = await import("../../../lib/linkedin/linkedin.mjs");
const linkedIn = await linkedInFollowUpFor(pool, date, { event, eventImage });
const today = ev.todayEastern();
const upcoming = date >= today;
const eventReady = eventReadiness(event, links, { eventImage, linkedIn });
const socialReady = socialPlanReadiness(social);
// The two sections at the top, rendered alike: bullets, each with its lines under it.
type ReadyBullet = { key: string; label: string; ok: boolean; info?: boolean; items: any[]; publicHref?: string; extra?: string | null };
const readySections: { id: string; title: string; bullets: ReadyBullet[] }[] = [
  { id: "h-ready", title: "Event readiness",
    bullets: eventReady.bullets.map((b) => ({ ...b, publicHref: b.key === "listings" ? eventReady.publicHref : undefined })) },
  { id: "h-social-ready", title: "Social plan readiness",
    bullets: [{ key: "social_plan", label: socialReady.label, ok: socialReady.ok, items: [...socialReady.problems, ...socialReady.posts],
      extra: socialReady.exists ? `${socialReady.scheduled}/${socialReady.total} posts scheduled` : null }] },
];
const isFuture = date > today;
const missing = ev.isReportMissing(event, today);
const notice = posted ? null : NOTICES[Astro.url.searchParams.get("notice") ?? ""] ?? null;
// A refused save shows the tab its form is on, whatever the URL says.
const tab = posted ? ACTION_TABS[posted.action] : pickTab(Astro.url.searchParams.get("tab"), date);

// Form values: what was just posted (on an error), else what is stored.
const from = (action: string) => (posted?.action === action ? posted.values : null);
const det = from("save") ?? {
  status: event.status,
  location: event.location ?? "",
  locationOther: event.locationOther ?? "",
  cancelReason: event.cancelReason ?? "",
  cancelReasonOther: event.cancelReasonOther ?? "",
  cancelAnnounced: event.cancelAnnounced ? "on" : "",
};
const r = event.report;
const rep = from("report") ?? {
  attendeeCount: r?.attendeeCount == null ? "" : String(r.attendeeCount),
  notes: r?.notes ?? "",
  blingGiven: r?.blingGiven == null ? "" : r.blingGiven ? "yes" : "no",
  blingDetails: r?.blingDetails ?? "",
};
const errFor = (action: string) => (posted?.action === action ? errors : {});
const detErr = errFor("save");
const liCancelErr = errFor("linkedin_cancel_done");
const repErr = errFor("report");
const SOURCES: Record<string, string> = { admin: "the admin", google_form: "the Google Form import", pre_form: "the pre-Form history import" };
// Listings: the posted values (on an error) for that platform's row, else what is stored.
const linkPosted = (p: string) => (posted && (posted.action === "link" || posted.action === "unlink") && posted.values.platform === p ? posted : null);
const linkVal = (p: string) => {
  const lp = linkPosted(p);
  return lp?.action === "link"
    ? { url: lp.values.url ?? "", externalId: lp.values.externalId ?? "" }
    : { url: links[p]?.url ?? "", externalId: links[p]?.externalId ?? "" };
};
const linkErr = (p: string) => (linkPosted(p) ? errors : {});
const mark = (ok: boolean, caution = false) => (caution ? "⚠" : ok ? "✓" : "✗");
// A LinkedIn listing URL is saved (made from here, or by hand outside the app): the
// create tools fold away under a <details>, open again while a LinkedIn action or its
// notice is on screen, or when there is no listing.
const linkedInListing = links.linkedin_event?.url ?? null;
const linkedInOpen = !linkedInListing || Boolean(linkedInResult)
  || (Astro.url.searchParams.get("notice") ?? "").startsWith("linkedin_");
const statusLabel = STATUS_LABELS[event.status] ?? "Scheduled";
// The Luma sync, read only for the Post Event tab.
const lumaRules = await import("../../../lib/admin/luma-sync-rules.mjs");
const lumaLaunch = lumaRules.lumaSyncLaunchDate();
const lumaSync = tab === "post"
  ? await (await import("../../../lib/admin/luma-sync.mjs")).getLumaSync(pool, date, { launch: lumaLaunch })
  : null;
---
<Admin title={`Event ${date}`} user={user} roles={roles}>
  <p><a href="/admin/events/">← Events</a></p>
  <h1 class="pinned">{longDay(date)}</h1>
  <p class="status">
    <span class={`badge ${event.status}`}>{statusLabel}</span>
    {missing && <span class="badge missing">Report missing</span>}
    {!event.exists && <span class="muted"> Not saved yet: the first save creates this event.</span>}
  </p>
  {notice && <p class="notice" role="status">{notice}</p>}
  {posted && errors.date && <p class="error" role="alert">{errors.date}</p>}
  {posted && errors.platform && <p class="error" role="alert">{errors.platform}</p>}
  {posted && errors.channel && <p class="error" role="alert">{errors.channel}</p>}

  {upcoming && readySections.map((sec) => (
    <section aria-labelledby={sec.id} class="ready">
      <h2 id={sec.id}>{sec.title}</h2>
      <ul class="bullets">
        {sec.bullets.map((b) => (
          <li class={`bullet ${b.info ? "info" : b.ok ? "ok" : "todo"}`}>
            <span class="mark" aria-hidden="true">{b.info ? "·" : mark(b.ok)}</span>
            <strong>{b.label}</strong>
            {!b.info && <span class="visually-hidden">{b.ok ? " (done)" : " (to do)"}</span>}
            {b.publicHref && <span class="muted"> · <a href={b.publicHref} target="_blank" rel="noopener">Public event page</a></span>}
            {b.extra && <span class="muted"> · {b.extra}</span>}
            {b.items.length > 0 && (
              <ul class="checklist">
                {b.items.map((i: any) => (
                  <li class={i.caution ? "caution" : i.ok ? "ok" : "todo"}>
                    <span class="mark" aria-hidden="true">{mark(i.ok, i.caution)}</span>
                    {i.href ? (/^https?:/.test(i.href) ? <a href={i.href} target="_blank" rel="noopener">{i.label}</a> : <a href={i.href}>{i.label}</a>) : i.label}
                    <span class="visually-hidden">{i.caution ? " (done, with a caution)" : i.ok ? " (done)" : " (missing)"}</span>
                    {i.note && <span class="muted"> · {i.note}</span>}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}

  <nav aria-label="Event page tabs" class="tabs pinned">
    <ul>
      {Object.entries(TABS).map(([key, label]) => (
        <li><a href={`?tab=${key}`} aria-current={key === tab ? "page" : undefined}>{label}</a></li>
      ))}
    </ul>
  </nav>

  {tab === "info" && (<>
  <section aria-labelledby="h-details">
    <h2 id="h-details">Status and location</h2>
    <form method="post" class="narrow event-details">
      <input type="hidden" name="action" value="save">
      <label for="status">Status</label>
      <select id="status" name="status" aria-invalid={detErr.status ? "true" : undefined}>
        {Object.entries(STATUS_LABELS).filter(([v]) => v !== "reported" || event.status === "reported")
          .map(([v, label]) => <option value={v} selected={det.status === v}>{label}</option>)}
      </select>
      {detErr.status && <p class="error" role="alert">{detErr.status}</p>}
      {/* Shown only while Cancelled is selected, and each "if Other" text box only while
          Other is chosen (CSS :has, no script). Not `required`: a hidden required field
          would block every save; the server checks the reason and the Other text. */}
      <fieldset class="cancel-fields">
        <legend>Why was it cancelled?</legend>
        {Object.entries(CANCEL_REASONS).map(([v, label]) => (
          <label class="check"><input type="radio" name="cancelReason" value={v} checked={det.cancelReason === v}> {label}</label>
        ))}
        {detErr.cancelReason && <p class="error" role="alert">{detErr.cancelReason}</p>}
        <div class="cancel-reason-other">
          <label for="cancelReasonOther">Reason, if Other</label>
          <input id="cancelReasonOther" name="cancelReasonOther" maxlength={LIMITS.cancelReasonOther} value={det.cancelReasonOther}
            aria-invalid={detErr.cancelReasonOther ? "true" : undefined}>
          {detErr.cancelReasonOther && <p class="error" role="alert">{detErr.cancelReasonOther}</p>}
        </div>
        <label class="check"><input type="checkbox" name="cancelAnnounced" value="on" checked={det.cancelAnnounced === "on"}> Announced on all socials</label>
      </fieldset>
      <label for="location">Location</label>
      <select id="location" name="location" aria-invalid={detErr.location ? "true" : undefined}>
        <option value="" selected={det.location === ""}>Not set (Lobby assumed)</option>
        {Object.entries(LOCATIONS).map(([v, label]) => <option value={v} selected={det.location === v}>{v === "other" ? "Other (describe it)" : label}</option>)}
      </select>
      {detErr.location && <p class="error" role="alert">{detErr.location}</p>}
      <div class="location-other">
        <label for="locationOther">Where, if Other</label>
        <input id="locationOther" name="locationOther" maxlength={LIMITS.locationOther} value={det.locationOther}
          aria-invalid={detErr.locationOther ? "true" : undefined}>
        {detErr.locationOther && <p class="error" role="alert">{detErr.locationOther}</p>}
      </div>
      <button type="submit">Save status and location</button>
    </form>
    <div id="linkedin-cancel">
      {linkedIn.cancel?.due && (
        <form method="post" class="linkedin-cancel" role="alert">
          <input type="hidden" name="action" value="linkedin_cancel_done">
          <p><strong>{linkedIn.cancel.message}</strong>: this event was posted on LinkedIn and is still live there.
            <a href={linkedIn.eventUrl} target="_blank" rel="noopener">Open the LinkedIn event</a>, cancel it, then tick it off here.</p>
          <button type="submit">Done on LinkedIn</button>
        </form>
      )}
      {linkedIn.cancel && !linkedIn.cancel.due && (
        <p class="muted">The <a href={linkedIn.eventUrl} target="_blank" rel="noopener">LinkedIn event</a> was marked done on LinkedIn (cancelled there), {easternDateTime(linkedIn.cancel.doneAt)}.</p>
      )}
      {liCancelErr.linkedin && <p class="error" role="alert">{liCancelErr.linkedin}</p>}
    </div>
  </section>

  <section aria-labelledby="h-links">
    <h2 id="h-links">Online Event Listings</h2>
    <p class="muted">The event on each platform. Luma is the public page's call to action; the others are listed for search engines.</p>
    {el.PLATFORM_KEYS.map((p) => {
      const v = linkVal(p);
      const e = linkErr(p);
      const stored = links[p];
      return (
        <form method="post" class="link-row" id={`link-${p}`}>
          <input type="hidden" name="platform" value={p}>
          <label for={`url-${p}`}>{el.PLATFORMS[p]}</label>
          <input id={`url-${p}`} name="url" type="text" inputmode="url" autocomplete="off" spellcheck="false" maxlength={el.URL_MAX} value={v.url}
            placeholder={p === "luma" ? "https://luma.com/…" : p === "eventbrite" ? "https://www.eventbrite.com/e/…" : p === "facebook_event" ? "https://www.facebook.com/events/…" : "https://www.linkedin.com/events/…"}
            aria-invalid={e.url ? "true" : undefined}>
          {e.url && <p class="error" role="alert">{e.url}</p>}
          {p === "luma" && (
            <>
              <label for="externalId-luma">Luma event id <span class="muted">(evt-…, from the embed code; needed for the RSVP embed)</span></label>
              <input id="externalId-luma" name="externalId" maxlength="100" value={v.externalId} pattern="evt-[A-Za-z0-9_\-]+"
                aria-invalid={e.externalId ? "true" : undefined}>
              {e.externalId && <p class="error" role="alert">{e.externalId}</p>}
            </>
          )}
          <div class="buttons">
            <button type="submit" name="action" value="link">Save {el.PLATFORMS[p]}</button>
            {stored && <button type="submit" name="action" value="unlink" class="secondary">Clear</button>}
          </div>
        </form>
      );
    })}
  </section>

  <EventImage date={date} image={eventImage} />

  <section aria-labelledby="h-linkedin">
    <h2 id="h-linkedin">LinkedIn event</h2>
    {linkedIn.drift && (
      <p class="linkedin-drift" role="alert">{linkedIn.drift.message} <a href={linkedIn.eventUrl} target="_blank" rel="noopener">Open the LinkedIn event</a></p>
    )}
    {linkedInListing ? (
      <>
        <p>Listed: <a href={linkedInListing} target="_blank" rel="noopener">the LinkedIn event</a>{linkedIn.eventUrl
          ? <span class="muted"> (created from here)</span>
          : <span class="muted"> (created manually outside the app: location, Event Image and cancel changes aren't tracked)</span>}</p>
        <details class="linkedin-tools" open={linkedInOpen}>
          <summary>LinkedIn authentication and create</summary>
          <LinkedInAuthentication returnTo={date} />
          <LinkedInEvent date={date} result={linkedInResult} />
        </details>
      </>
    ) : (
      <>
        <LinkedInAuthentication returnTo={date} />
        <LinkedInEvent date={date} result={linkedInResult} />
      </>
    )}
  </section>

  </>)}

  {tab === "social" && (<>
    <SocialPlan date={date} order={social} posted={posted && SOCIAL.has(posted.action) ? posted : null} errors={errors} />
  </>)}

  {tab === "post" && (<>
  <section aria-labelledby="h-report">
    <h2 id="h-report">Report</h2>
    {r && (
      <p class="muted">
        From {SOURCES[r.source] ?? r.source}{r.by && <> ({r.by})</>}, last saved {easternDateTime(r.updatedAt)}.
      </p>
    )}
    {event.status === "cancelled"
      ? <p class="muted">No report for a cancelled event. If it went ahead, set its status back to Scheduled (Event Info tab), then file the report here.</p>
      : isFuture
        ? null
        : (
          <form method="post" class="narrow">
            <input type="hidden" name="action" value="report">
            <label for="attendeeCount">Attendee count</label>
            <div class="count-row">
              <input id="attendeeCount" name="attendeeCount" type="number" inputmode="numeric" min="0" max={LIMITS.attendeeCount} step="1"
                required value={rep.attendeeCount} aria-invalid={repErr.attendeeCount ? "true" : undefined} aria-describedby="checkin-note">
              <p id="checkin-note" class="checkins">
                Check-in count (not attendance): <strong>{event.checkinCount}</strong>
                <span class="muted">(not everyone checks in; Debug check-ins left out)</span>
                {event.checkinCount > 0 && <> · <a href={`/admin/checkins/?date=${date}`}>who</a></>}
              </p>
            </div>
            {repErr.attendeeCount && <p class="error" role="alert">{repErr.attendeeCount}</p>}

            <fieldset>
              <legend>Bring a Friend Bling given out?</legend>
              <label class="check"><input type="radio" name="blingGiven" value="yes" checked={rep.blingGiven === "yes"} required> Yes</label>
              <label class="check"><input type="radio" name="blingGiven" value="no" checked={rep.blingGiven === "no"}> No</label>
              {repErr.blingGiven && <p class="error" role="alert">{repErr.blingGiven}</p>}
            </fieldset>
            <label for="blingDetails">Bling details, if given <span class="muted">(who got it, who they brought)</span></label>
            <textarea id="blingDetails" name="blingDetails" rows="2" maxlength={LIMITS.blingDetails}
              aria-invalid={repErr.blingDetails ? "true" : undefined}>{rep.blingDetails}</textarea>
            {repErr.blingDetails && <p class="error" role="alert">{repErr.blingDetails}</p>}

            <label for="notes">Notes and feedback</label>
            <textarea id="notes" name="notes" rows="4" maxlength={LIMITS.notes}
              aria-invalid={repErr.notes ? "true" : undefined}>{rep.notes}</textarea>
            {repErr.notes && <p class="error" role="alert">{repErr.notes}</p>}
            <button type="submit">{r ? "Update report" : "Submit report"}</button>
          </form>
        )}
  </section>

  {lumaSync && <LumaSyncSection sync={lumaSync} launch={lumaLaunch} />}

  <EventMedia date={date} />
  </>)}
</Admin>

<style>
  section { margin-top: 2rem; }
  .event-details .cancel-fields { display: none; }
  .event-details:has(select[name="status"] option[value="cancelled"]:checked) .cancel-fields { display: block; }
  .event-details .cancel-reason-other { display: none; }
  .event-details:has(input[name="cancelReason"][value="other"]:checked) .cancel-reason-other { display: block; }
  .event-details .location-other { display: none; }
  .event-details:has(select[name="location"] option[value="other"]:checked) .location-other { display: block; }
  .event-details select { display: block; }
  /* #36: the title and the tabs stay at the top on scroll; the readiness sections (between them, ADR 0012)
     scrolls under the title. The title is one line of fixed height so the tabs can pin right
     below it; html's scroll-padding keeps anchor jumps and focused fields clear of both. */
  :global(html) { --pin-title: 3rem; --pin-tabs: 2.5rem; scroll-padding-top: calc(var(--pin-title) + var(--pin-tabs) + 0.75rem); }
  .pinned { position: sticky; z-index: 2; background: var(--bg); }
  h1.pinned { top: 0; height: var(--pin-title); line-height: var(--pin-title); margin: 0 0 0.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tabs.pinned { top: var(--pin-title); }
  .tabs { margin-top: 1.25rem; border-bottom: 1px solid var(--line); }
  .tabs ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.25rem; margin: 0; padding: 0; }
  .tabs a { display: inline-block; padding: 0.4rem 0.9rem; border: 1px solid transparent; border-bottom: 0; border-radius: 6px 6px 0 0; text-decoration: none; }
  .tabs a[aria-current="page"] { border-color: var(--line); font-weight: 600; }
  fieldset { border: 0; padding: 0; margin: 0.75rem 0 0; }
  legend { font-weight: 600; padding: 0; }
  textarea { width: 100%; padding: 0.6rem; font: inherit; border: 1px solid var(--line); border-radius: 6px; background: transparent; color: inherit; }
  .count-row { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; }
  .count-row input { width: 8rem; }
  .checkins { margin: 0; }
  .badge { display: inline-block; padding: 0.1rem 0.5rem; border: 1px solid var(--line); border-radius: 4px; font-weight: 600; }
  .badge.cancelled, .badge.missing { color: var(--err); border-color: var(--err); }
  .badge.reported { color: var(--accent); border-color: var(--accent); }
  .ready + .ready { margin-top: 0.5rem; }
  .ready { margin-top: 1rem; padding: 0.5rem 0.75rem; border: 1px solid var(--line); border-radius: 6px; }
  .ready h2 { margin: 0; font-size: 1.1rem; }
  .bullets { list-style: none; padding: 0; margin: 0.25rem 0 0; }
  .bullets > li { margin: 0.2rem 0; }
  .checklist { list-style: none; padding: 0 0 0 1.4em; margin: 0.15rem 0 0; display: flex; flex-wrap: wrap; gap: 0.15rem 1.25rem; font-size: 0.9375rem; }
  .ready .mark { display: inline-block; width: 1.1em; font-weight: 700; }
  .ready .ok > .mark { color: var(--accent); }
  .ready .todo > .mark { color: var(--err); }
  .ready .caution > .mark { color: var(--warn); }
  .ready .info > .mark { color: var(--muted); }
  .linkedin-tools > summary { cursor: pointer; color: var(--muted); }
  .link-row { margin: 1rem 0 0; padding-top: 0.75rem; border-top: 1px solid var(--line); max-width: 40rem; }
  .link-row label:first-of-type { font-weight: 600; }
  .link-row input { width: 100%; }
  .link-row .buttons { display: flex; gap: 0.5rem; margin-top: 0.5rem; }
  .linkedin-cancel, .linkedin-drift { margin: 0.75rem 0; padding: 0.5rem 0.75rem; border: 1px solid var(--err); border-left-width: 4px; border-radius: 6px; max-width: 40rem; }
  .linkedin-cancel strong { color: var(--err); }
  @media (max-width: 30rem) {
    h1.pinned { font-size: 1.25rem; }
    .tabs a { padding: 0.4rem 0.55rem; font-size: 0.9375rem; }
  }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
