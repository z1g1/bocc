---
// /admin/email-list/: attendees who agreed to email (ok_to_email, no test rows), the
// CSV export (POST /api/admin/email-list.csv, audited) and opt-out
// (POST /api/admin/email-list/opt-out, audited). Admin only.
import Admin from "../../../layouts/Admin.astro";
import { requireRole } from "../../../lib/admin/roles.mjs";
export const prerender = false;

const denied = requireRole(Astro.locals, "admin");
if (denied) return denied;

const { user, roles = [] } = Astro.locals;
const { pool } = await import("../../../lib/admin/db.mjs");
const { listEmailList, onLumaLabel } = await import("../../../lib/admin/email-list.mjs");
const people = await listEmailList(pool);
const notice = Astro.url.searchParams.get("notice");
---
<Admin title="Email list" user={user} roles={roles} wide>
  <h1>Email list</h1>
  {notice === "opted-out" && <p class="notice" role="status">Opted out. They won't be in the next export.</p>}

  <p>{people.length} attendee{people.length === 1 ? "" : "s"} agreed to email.</p>
  <form method="post" action="/api/admin/email-list.csv">
    <button type="submit">Download CSV</button>
    <span class="muted"> Each download is recorded in the audit log.</span>
  </form>

  {people.length > 0 && (
    <div class="scroll">
      <table class="data">
        <thead><tr><th>Name</th><th>Business</th><th>Email</th><th>Date added</th><th>On Luma</th><th></th></tr></thead>
        <tbody>
          {people.map((s: any) => (
            <tr>
              <td><a href={`/admin/attendees/${s.id}/`}>{s.name}</a></td>
              <td>{s.businessName}</td>
              <td>{s.email}</td>
              <td>{s.dateAdded}</td>
              <td>{onLumaLabel(s)}</td>
              <td>
                <form method="post" action="/api/admin/email-list/opt-out" class="inline">
                  <input type="hidden" name="attendeeId" value={s.id}>
                  <input type="hidden" name="return" value="/admin/email-list/">
                  <button type="submit" class="secondary small" aria-label={`Opt out ${s.name}`}>Opt out</button>
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</Admin>
