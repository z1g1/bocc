---
// Cream band of big orange stats. block: label (accessible name), items[] {value, label}.
const { block: b } = Astro.props;
---
<section class="stat-strip" aria-label={b.label || undefined}>
  <div class="container stat-strip__grid">
    {b.items.map((item: any) => (
      <div class="stat-strip__item">
        <div class="stat-strip__value">{item.value}</div>
        <div class="stat-strip__label">{item.label}</div>
      </div>
    ))}
  </div>
</section>
