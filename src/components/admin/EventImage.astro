---
// The Event Image section of the Event Info tab (ADR 0012 decision 3). Admin only.
//   <EventImage date="2026-11-24" image={resolvedEventImage} />
// `image` comes from src/lib/admin/event-image.mjs getEventImage (the page also uses it
// for the Readiness section's Default or Custom Cover Image).
//
// - Two previews with download buttons: the square/original (for Luma) and the 16:9
//   version (the cover, for the listings entered by hand and LinkedIn: the image at
//   full height centred on the "Just the Beans" background, never cropped, ticket
//   #40). Stored files through short-lived
//   presigned GETs (re-signed on every render, downloads with a signed
//   Content-Disposition); the logo default from the site itself.
// - Upload (set or change): /js/admin-media.js checks the image (PNG/JPEG, at least
//   480x270, at most 8 MiB, as media.mjs and the label say; a 1:1 square is asked for,
//   but one that isn't only gets a warning), shows the composed
//   16:9 version in the preview, makes the display, thumbnail and 16:9 copies and PUTs
//   all four to the bucket.
//   Hidden until that script runs. The new image replaces the old one on complete.
// - Pick (ticket #21): the recent Photos from Event (event-image.mjs listPickablePhotos)
//   as thumbnails in a plain form post to /api/admin/media/event-image/pick: the event
//   then references the photo. When the picked photo has no 16:9 cover copy
//   (data-needs-cover), /js/admin-media.js makes one first (its display copy on the
//   beans background, PUT through /api/admin/media/{id}/cover). Without the script the
//   pick still works, and the section then offers "Make the 16:9 version" (which needs it).
// - A 16:9 version made under the old centre-crop rule (image.coverOutdated, ticket
//   #40) is remade by the script as the page opens (the make-cover form, data-auto);
//   an outdated photo in the picker counts as having none. /admin/media/covers/ remakes
//   every outdated version at once.
// - Clear: a plain form post to /api/admin/media/event-image/clear (back to the logo;
//   a picked photo is only un-referenced, never deleted).
// - Unfinished Event Image uploads over a day old, with a delete button.
// - Storage not configured: the message, and the previews only when it's the logo.
import { hasRole } from "../../lib/admin/roles.mjs";
import { getStorage, isIsoDate } from "../../lib/admin/storage.mjs";
import { STORAGE_OFF_MESSAGE } from "../../lib/admin/media-http.mjs";

interface Props {
  /** The event's date, YYYY-MM-DD. */
  date: string;
  /** The resolved Event Image (event-image-rules.mjs EventImage). */
  image: any;
}
const { date, image } = Astro.props;
const allowed = hasRole(Astro.locals, "admin") && isIsoDate(date);
const { storage } = allowed ? getStorage() : { storage: null };

const NOTICES: Record<string, string> = {
  "event-image-cleared": "Event Image cleared. The event uses the BOCC logo.",
  "event-image-cleared-partial": "Event Image cleared. Some of its files couldn't be removed from storage; they are logged for cleanup.",
  "event-image-unchanged": "There was no Event Image to clear.",
  "event-image-picked": "Event Image set to a photo from the event.",
  "event-image-picked-partial": "Event Image set to a photo from the event. Some files of the uploaded image it replaced couldn't be removed from storage; they are logged for cleanup.",
  "event-image-unchanged-pick": "That photo is already the Event Image.",
  deleted: "Unfinished upload deleted.",
  "deleted-partial": "Unfinished upload deleted. Some of its files couldn't be removed from storage; they are logged for cleanup.",
};
const notice = NOTICES[Astro.url.searchParams.get("media") ?? ""] ?? null;

const isDefault = image?.source === "default";
const ext = (key: string) => key.split(".").pop();
/** A file's preview and download links, or null when it can't be shown. */
function links(file: any, downloadName: string) {
  if (!file) return null;
  if ("path" in file) return { src: file.path, href: file.path, download: file.path.split("/").pop() };
  if (!storage) return null;
  return {
    src: storage.presignGet({ key: file.key }).url,
    href: storage.presignGet({ key: file.key, downloadName }).url,
    download: "",
  };
}
let square: ReturnType<typeof links> = null;
let cover: ReturnType<typeof links> = null;
let stale: any[] = [];
let pickable: any[] = [];
if (allowed && image) {
  const sq = links(image.display, "");
  const orig = links(image.original, `bocc-${date}-event-image.${"key" in image.original ? ext(image.original.key) : "png"}`);
  square = sq && orig ? { ...orig, src: sq.src } : null;
  cover = links(image.cover, `bocc-${date}-event-image-16x9.jpg`);
  if (storage) {
    const { listStalePending } = await import("../../lib/admin/media.mjs");
    const { pool } = await import("../../lib/admin/db.mjs");
    stale = (await listStalePending(pool, { date })).filter((m: any) => m.kind === "event_image");
    const { listPickablePhotos } = await import("../../lib/admin/event-image.mjs");
    pickable = (await listPickablePhotos(pool, date)).map((m: any) => ({
      ...m,
      // An outdated 16:9 version (old centre-crop rule) counts as none: picking remakes it.
      coverKey: m.coverOutdated ? null : m.coverKey,
      thumbUrl: storage.presignGet({ key: m.thumbKey }).url,
      // The script composes the 16:9 version from the display copy (CORS GET from the bucket).
      displayUrl: m.coverKey && !m.coverOutdated ? null : storage.presignGet({ key: m.displayKey }).url,
      current: image.source === "referenced" && image.mediaId === m.id,
    }));
  }
}
const statusId = `event-image-status-${date}`;
const pickStatusId = `event-image-pick-status-${date}`;
// A picked photo without its 16:9 copy (picked without the script): offer to make it.
// One made under the old rule (uploaded or picked): the script remakes it on open.
const coverToMake = storage && ((image?.source === "referenced" && !image.cover) || image?.coverOutdated)
  ? { id: image.mediaId, displayUrl: storage.presignGet({ key: image.display.key }).url, auto: Boolean(image.coverOutdated) } : null;
const previewId = `event-image-preview-${date}`;
const warningId = `event-image-warning-${date}`;
const inputId = `event-image-file-${date}`;
const fmtTime = (d: Date) =>
  new Intl.DateTimeFormat("en-US", { timeZone: "America/New_York", dateStyle: "medium", timeStyle: "short" }).format(d);
---
{allowed && image && (
  <section class="event-image" id="event-image" aria-labelledby="h-event-image">
    <h2 id="h-event-image">Event Image</h2>
    <p class="muted">One image for every Online Event Listing this week. Make it a <strong>1:1 square</strong>: the square/original is for Luma as is. The 16:9 version (for the listings entered by hand and LinkedIn) is made for you: the image at full height, centred on the BOCC "Just the Beans" background, never cropped.</p>
    {notice && <p class="notice" role="status">{notice}</p>}
    <p class="source">
      {isDefault ? "Using the default: the BOCC logo."
        : image.source === "uploaded" ? "Uploaded for this event."
          : `A photo from the ${image.eventDate} event.`}
    </p>

    <div class="previews">
      <figure>
        {square ? <img src={square.src} alt={`Event Image, square/original, ${date}`} loading="lazy" decoding="async"> : <p class="muted">Preview not available.</p>}
        <figcaption>Square/original <span class="muted">(Luma)</span></figcaption>
        {square && <p><a class="button small" href={square.href} download={square.download}>Download square/original</a></p>}
      </figure>
      <figure>
        {cover ? <img src={cover.src} alt={`Event Image, 16:9 version, ${date}`} loading="lazy" decoding="async"> : <p class="muted">No 16:9 version yet.</p>}
        <figcaption>16:9 <span class="muted">(listings entered by hand, LinkedIn)</span></figcaption>
        {image.coverOutdated && <p class="muted">This 16:9 version is a centre crop, made under the old rule: it is being remade on the beans background.</p>}
        {cover && <p><a class="button small" href={cover.href} download={cover.download}>Download 16:9</a></p>}
      </figure>
    </div>

    {!storage ? <p class="muted" data-media-off>{STORAGE_OFF_MESSAGE}</p> : (
      <>
        <p class="muted" data-media-nojs>Uploading the Event Image needs JavaScript.</p>
        <form class="media-upload" data-media-upload data-kind="event_image" data-event-date={date} data-status={statusId} data-warning={warningId} data-preview={previewId} hidden>
          <input type="hidden" name="kind" value="event_image">
          <label for={inputId}>{isDefault ? "Upload an Event Image" : "Change the Event Image"} <span class="muted">(a 1:1 square PNG or JPEG, at least 480×270, up to 8 MB; one that isn't square only gets a warning)</span></label>
          <input id={inputId} type="file" name="files" accept="image/jpeg,image/png" required>
          <p class="warning" id={warningId} role="status" aria-live="polite"></p>
          <figure class="composed">
            <img id={previewId} alt="The 16:9 version of the chosen image, on the beans background" hidden>
          </figure>
          <button type="submit">{isDefault ? "Upload Event Image" : "Replace Event Image"}</button>
        </form>
        <p class="media-status" id={statusId} role="status" aria-live="polite"></p>

        {coverToMake && (
          <form class="inline" data-make-cover data-auto={coverToMake.auto ? "" : undefined} data-media-id={coverToMake.id} data-display-url={coverToMake.displayUrl} data-status={pickStatusId} hidden>
            <button type="submit">{coverToMake.auto ? "Remake the 16:9 version" : "Make the 16:9 version"}</button>
          </form>
        )}

        {pickable.length > 0 && (
          <details class="event-image-pick-toggle">
          <summary class="muted">Or pick a Photo from Event (recent events; the event uses the photo itself, not a copy)</summary>
          <form method="post" action="/api/admin/media/event-image/pick" class="event-image-pick" data-event-image-pick data-status={pickStatusId}>
            <fieldset aria-label="Photos from recent events">
              <input type="hidden" name="eventDate" value={date}>
              <ul class="plain pick-grid">
                {pickable.map((m: any) => (
                  <li>
                    <label>
                      {m.coverKey
                        ? <input type="radio" name="mediaId" value={m.id} checked={m.current} required>
                        : <input type="radio" name="mediaId" value={m.id} data-needs-cover data-display-url={m.displayUrl} checked={m.current} required>}
                      <img src={m.thumbUrl} alt={`Photo from the ${m.eventDate} event`} loading="lazy" decoding="async">
                      <span class="muted">{m.eventDate}{m.current ? " (in use)" : ""}</span>
                    </label>
                  </li>
                ))}
              </ul>
              <button type="submit">Use this photo</button>
            </fieldset>
          </form>
          </details>
        )}
        <p class="media-status" id={pickStatusId} role="status" aria-live="polite"></p>

        {!isDefault && (
          <form method="post" action="/api/admin/media/event-image/clear" class="inline" data-confirm={image.source === "uploaded"
            ? "Clear the Event Image? The event goes back to the BOCC logo, and the uploaded image is deleted."
            : "Clear the Event Image? The event goes back to the BOCC logo. The photo itself stays in its gallery."}>
            <input type="hidden" name="eventDate" value={date}>
            <button type="submit" class="secondary">Clear (use the BOCC logo)</button>
          </form>
        )}

        {stale.length > 0 && (
          <div class="media-stale">
            <h3>Unfinished uploads</h3>
            <ul class="plain">
              {stale.map((m: any) => (
                <li>
                  <span>Event Image, started {fmtTime(m.createdAt)}</span>
                  <form method="post" action={`/api/admin/media/${m.id}/delete`} class="inline" data-confirm="Delete this unfinished upload?">
                    <button type="submit" class="small secondary">Delete</button>
                  </form>
                </li>
              ))}
            </ul>
          </div>
        )}
        <script is:inline type="module" src="/js/admin-media.js"></script>
      </>
    )}
  </section>
)}

<style>
  .previews { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; }
  .previews figure { margin: 0; flex: 0 1 18rem; }
  .previews img { display: block; max-width: 100%; height: auto; max-height: 12rem; border: 1px solid var(--line); border-radius: 4px; }
  .previews figcaption { margin-top: 0.25rem; font-weight: 600; }
  .previews p { margin: 0.25rem 0; }
  .warning { min-height: 1.2em; color: var(--err); }
  .composed { margin: 0 0 0.5rem; }
  .composed img { display: block; max-width: 100%; height: auto; max-height: 12rem; border: 1px solid var(--line); border-radius: 4px; }
  .media-status { min-height: 1.5em; }
  .pick-grid { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .pick-grid label { display: flex; flex-direction: column; align-items: flex-start; gap: 0.25rem; cursor: pointer; }
  .pick-grid img { display: block; width: 8rem; height: 6rem; object-fit: cover; border: 1px solid var(--line); border-radius: 4px; }
  .event-image-pick-toggle { margin: 1rem 0 0.5rem; }
  .event-image-pick-toggle summary { font-size: 0.875rem; cursor: pointer; }
  .event-image-pick fieldset { border: 0; padding: 0; margin: 0.5rem 0; }
</style>
