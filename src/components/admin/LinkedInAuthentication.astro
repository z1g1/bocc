---
// The signed-in Admin's LinkedIn authentication (ADR 0012 decision 4, issue #23;
// GLOSSARY.md, #58), shown in the LinkedIn section of the event page's Event Info tab
// and on /admin/account/:
//   <LinkedInAuthentication returnTo="2026-11-24" />   or   <LinkedInAuthentication returnTo="account" />
// "Authenticated as <name>. The LinkedIn authentication expires on <date> (in N days)":
// amber under 7 days, red once expired, with Re-authenticate. Authenticate and
// Re-authenticate are plain GET links to /api/admin/linkedin/connect (it redirects to
// LinkedIn: a POST form would be blocked by the CSP's form-action 'self'). Remove POSTs
// to /api/admin/linkedin/disconnect. The route names and the ?linkedin=<notice> values
// keep their old "connect" words: the callback URL is registered with LinkedIn.
// The callback and disconnect come back with ?linkedin=<notice>#linkedin.
// Renders nothing for anyone without the admin role.
import { hasRole } from "../../lib/admin/roles.mjs";
import { PERMITTED_SERVICES_URL } from "../../lib/linkedin/rules.mjs";

interface Props { returnTo: string }
const { returnTo } = Astro.props;
const allowed = hasRole(Astro.locals, "admin");

let configured = false;
let status: any = null;
if (allowed) {
  const li = await import("../../lib/linkedin/linkedin.mjs");
  configured = li.linkedInEnv().enabled;
  if (configured) {
    const { pool } = await import("../../lib/admin/db.mjs");
    status = await li.authenticationStatus(pool, Astro.locals.user!.id);
  }
}

const NOTICES: Record<string, string> = {
  connected: "Authenticated with LinkedIn.",
  disconnected: "LinkedIn authentication removed. The app's access on LinkedIn itself is removed on LinkedIn's Permitted services page.",
  unchanged: "Nothing changed.",
  cancelled: "LinkedIn authentication cancelled. Nothing was saved.",
  failed: "LinkedIn didn't complete the authentication. Nothing was saved: try again.",
  scopes: "LinkedIn didn't grant every permission the app needs. Authenticate again and allow all of them.",
};
const notice = NOTICES[Astro.url.searchParams.get("linkedin") ?? ""] ?? null;
const fmt = new Intl.DateTimeFormat("en-US", { dateStyle: "medium", timeZone: "America/New_York" });
const connectHref = `/api/admin/linkedin/connect?return=${encodeURIComponent(returnTo)}`;
const days = (n: number) => `${n} day${n === 1 ? "" : "s"}`;
---
{allowed && (
  <div class="linkedin-authentication" id="linkedin" data-linkedin-level={status?.level ?? (configured ? "none" : "off")}>
    {notice && <p class="notice" role="status">{notice}</p>}
    {!configured ? (
      <p class="muted">LinkedIn isn't configured on this deploy (LINKEDIN_CLIENT_ID, LINKEDIN_CLIENT_SECRET, LINKEDIN_TOKEN_KEY).</p>
    ) : !status ? (
      <>
        <p>Not authenticated with LinkedIn. Authenticate with your own LinkedIn profile to create the weekly LinkedIn event.</p>
        <p><a class="button" href={connectHref}>Authenticate with LinkedIn</a></p>
      </>
    ) : (
      <>
        <p class:list={["linkedin-status", `linkedin-${status.level}`]}>
          {status.level === "red"
            ? <>Authenticated as {status.name}. The LinkedIn authentication expired on {fmt.format(status.expiresAt)}. Re-authenticate to use LinkedIn.</>
            : <>Authenticated as {status.name}. The LinkedIn authentication expires on {fmt.format(status.expiresAt)} (in {days(status.daysLeft)})</>}
        </p>
        <div class="linkedin-actions">
          <a class="button" href={connectHref}>Re-authenticate</a>
          <form method="post" action="/api/admin/linkedin/disconnect">
            <input type="hidden" name="return" value={returnTo}>
            <button type="submit" class="secondary">Remove LinkedIn authentication</button>
          </form>
        </div>
      </>
    )}
    <p class="muted">To remove the app's access on LinkedIn too, use LinkedIn's <a href={PERMITTED_SERVICES_URL} rel="noopener noreferrer">Permitted services</a> page.</p>
  </div>
)}

<style>
  .linkedin-authentication { --amber: #8a5a00; }
  @media (prefers-color-scheme: dark) { .linkedin-authentication { --amber: #f0b44a; } }
  .linkedin-status { padding: 0.4rem 0.75rem; border-left: 3px solid var(--line); }
  .linkedin-ok { border-left-color: var(--accent); }
  .linkedin-amber { border-left-color: var(--amber); color: var(--amber); }
  .linkedin-red { border-left-color: var(--err); color: var(--err); font-weight: 600; }
  .linkedin-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .linkedin-actions form { margin: 0; }
  .linkedin-actions button { margin: 0; }
  a.button { display: inline-block; padding: 0.6rem 1rem; font-weight: 600; border-radius: 6px; background: var(--accent); color: var(--bg); text-decoration: none; }
</style>
