---
// Event readiness at a glance for an upcoming Event in the admin lists (#59): "Ready",
// or what is missing ("2/5 listings · Location not set", "Cancellation not announced").
// `tag` is eventReadiness().tag (src/lib/admin/event-readiness.mjs), loaded for the list by
// eventReadinessByDate() (src/lib/admin/event-readiness-load.mjs).
interface Props { tag?: { label: string; ok: boolean } }
const { tag } = Astro.props;
---
{tag && <span class:list={["ready-tag", { complete: tag.ok }]}>{tag.label}</span>}

<style>
  .ready-tag { font-size: 0.85em; padding: 0 0.35rem; border: 1px solid var(--line); border-radius: 4px; margin-left: 0.25rem; }
  .ready-tag:not(.complete) { color: var(--err); border-color: var(--err); }
</style>
