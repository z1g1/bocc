---
// The LinkedIn event on the Event Info tab (ADR 0012, issue #25). Admin only.
//   <LinkedInEvent date="2026-11-24" result={createResultOrNull} />
// `result` is what src/lib/linkedin/linkedin.mjs createLinkedInEvent returned when the
// page was just POSTed with action=linkedin_create (the page renders it straight
// away: a dry run changes nothing, so there is no redirect).
//
// - The full preview of what would be sent: name, description, times, address, venue
//   details, external link, 16:9 Event Image, visibility, the post commentary, and the payloads.
// - "Create live event" opens a native <dialog> (/js/admin-linkedin.js) that names the
//   date, title and visibility, warns this is a REAL public event and a PUBLIC post,
//   quotes the commentary and, on a dry run, says "Dry run: nothing will be sent". Its
//   form sends confirm=live, which the server requires.
//   Without JavaScript the button submits without confirm=live; the server refuses it
//   (409) and the page shows the same dialog open inline, with the confirm button.
// - After a dry run: the requests that would have been sent. After a refusal: why.
// - The live ledger (#26), by status:
//     posted   links to the LinkedIn event and the LinkedIn post, and the reminder to
//              make a LinkedIn repost from the LinkedIn page, by hand: the app can't post
//              as the LinkedIn page (#49). The listing was filled when it was posted
//     created  the event link and "Publish the LinkedIn post" (action linkedin_publish),
//              which retries only the LinkedIn post. It confirms like the create: its own
//              <dialog> (a PUBLIC LinkedIn post from your LinkedIn profile, naming the
//              post's author, the commentary quoted), confirm=live only
//              in the dialog's form, the same no-JS inline fallback. Not offered once
//              the date has passed or the event is cancelled (the server refuses too)
//     pending  check LinkedIn, then "I checked: nothing was created, allow retry"
//              (action linkedin_allow_retry)
//   After a failed live step (`result.failure`): LinkedIn's error in plain language.
import { hasRole } from "../../lib/admin/roles.mjs";
import { getStorage, isIsoDate } from "../../lib/admin/storage.mjs";
import { EVENT_ADDRESS, EXTERNAL_URL } from "../../lib/linkedin/rules.mjs";
import { longDay } from "../../lib/admin/format.mjs";

interface Props { date: string; result?: any }
const { date, result = null } = Astro.props;
const allowed = hasRole(Astro.locals, "admin") && isIsoDate(date);

let configured = false;
let p: any = null;
if (allowed) {
  const li = await import("../../lib/linkedin/linkedin.mjs");
  configured = li.linkedInEnv().enabled;
  if (configured) {
    const { pool } = await import("../../lib/admin/db.mjs");
    p = result?.preview ?? await li.linkedInEventPreview(pool, Astro.locals.user!.id, date);
  }
}
const dryRun = p?.mode !== "live";
// With a ledger row the ledger block says what to do, so its "ledger" refusal isn't repeated.
const refusals: { code: string; message: string }[] = result && !result.ok ? result.refusals
  : (p?.refusals ?? []).filter((r: { code: string }) => r.code !== "ledger");
const needsConfirm = Boolean(result && !result.ok && result.refusals.length === 1 && result.refusals[0].code === "confirm");
const canCreate = p?.action === "create" && (p.refusals.length === 0);
// Publish the LinkedIn post: a created row, not past or cancelled (the matrix's only other refusal is "ledger").
const canPublish = p?.action === "publish_retry" && p.refusals.every((r: { code: string }) => r.code === "ledger");

const time = new Intl.DateTimeFormat("en-US", { timeZone: "America/New_York", hour: "numeric", minute: "2-digit", timeZoneName: "short" });
const when = p?.spec ? `${longDay(date)}, ${time.format(p.spec.startsAt)} to ${time.format(p.spec.endsAt)}` : "";
const a = EVENT_ADDRESS;
const address = `${a.line1}, ${a.city}, ${a.geographicArea} ${a.postalCode}, ${a.country}`;

// The 16:9 Event Image: a checked-in file from the site, a stored copy through a presigned GET.
let image16x9Src: string | null = null;
const image16x9 = p?.image?.image16x9;
if (image16x9) {
  if ("path" in image16x9) image16x9Src = image16x9.path;
  else {
    const { storage } = getStorage();
    image16x9Src = storage ? storage.presignGet({ key: image16x9.key }).url : null;
  }
}
const SOURCE: Record<string, string> = { uploaded: "the uploaded Event Image", referenced: "the picked Photo from Event", default: "the BOCC logo default" };
const STATUS: Record<string, string> = {
  pending: "Pending: a create was started and its outcome is unknown. Check LinkedIn before doing anything else.",
  created: "Created on LinkedIn, but its LinkedIn post isn't published yet. LinkedIn keeps the LinkedIn event hidden until its LinkedIn post is published.",
  posted: "Posted on LinkedIn.",
};
const STEP: Record<string, string> = {
  image_init: "starting the 16:9 Event Image upload", image_upload: "uploading the 16:9 Event Image", create: "creating the event", post: "publishing the post",
};
const failure = result && !result.ok ? result.failure ?? null : null;
const json = (v: unknown) => JSON.stringify(v, null, 2);
// The LinkedIn post's author: the Admin's LinkedIn profile (never the LinkedIn page).
const postedAs = p?.authentication ? p.authentication.name : "your LinkedIn profile (authenticate with LinkedIn first)";
---
{allowed && (
  <div class="linkedin-event" id="linkedin-event">
    {!configured ? null : !p ? null : (
      <>
        <p class:list={["mode", dryRun ? "mode-dry" : "mode-live"]}>
          {dryRun
            ? <>Dry run on this deploy: nothing is sent to LinkedIn (LINKEDIN_LIVE is not set).</>
            : <>Live: Create live event sends to LinkedIn.</>}
        </p>

        {failure && (
          <div class="refusals" role="alert" data-failure={failure.step}>
            <p><strong>LinkedIn failed while {STEP[failure.step] ?? failure.step}:</strong> {failure.message}</p>
            {failure.step !== "post" && failure.nothingCreated && (
              <p>LinkedIn refused before creating the event, so nothing was created. Fix the cause, then allow retry below.</p>
            )}
            {result.postUrl && <p>The post may be out: <a href={result.postUrl} rel="noopener noreferrer">check it on LinkedIn</a> before publishing again.</p>}
          </div>
        )}

        {p.ledger && (
          <div class="ledger" data-ledger={p.ledger.status}>
            <p>
              <strong>Ledger:</strong> {STATUS[p.ledger.status] ?? p.ledger.status}
              {p.ledger.eventUrl && <> <a href={p.ledger.eventUrl} rel="noopener noreferrer">LinkedIn event</a></>}
              {p.ledger.postUrl && <> · <a href={p.ledger.postUrl} rel="noopener noreferrer">post</a></>}
            </p>
            {p.ledger.status === "posted" && (
              <p class="next"><strong>Next:</strong> make a LinkedIn repost of your LinkedIn post from the LinkedIn page. The LinkedIn listing is filled in.</p>
            )}
            {canPublish && (
              <>
                <form method="post" action={`/admin/events/${date}/#linkedin-event`}>
                  <input type="hidden" name="action" value="linkedin_publish">
                  <p class="muted">Publish the LinkedIn post retries only the LinkedIn post, as a PUBLIC LinkedIn post from your LinkedIn profile ({postedAs}).
                    The LinkedIn event already exists and LinkedIn can't delete it, so it is never created again.</p>
                  <button type="submit" data-linkedin-open="linkedin-publish-confirm">Publish the LinkedIn post</button>
                </form>
                <dialog id="linkedin-publish-confirm" aria-labelledby="linkedin-publish-confirm-title" open={needsConfirm}>
                  <form method="post" action={`/admin/events/${date}/#linkedin-event`}>
                    <input type="hidden" name="action" value="linkedin_publish">
                    <input type="hidden" name="confirm" value="live">
                    <h3 id="linkedin-publish-confirm-title">Publish the LinkedIn post?</h3>
                    {needsConfirm && <p class="muted">Confirm here to go ahead.</p>}
                    {dryRun && <p class="dry"><strong>Dry run: nothing will be sent.</strong></p>}
                    <dl>
                      <dt>Date</dt><dd>{longDay(date)}</dd>
                      <dt>Title</dt><dd>{p.ledger.name}</dd>
                      <dt>Posted by</dt><dd>{postedAs}</dd>
                    </dl>
                    <p>This makes a <strong>PUBLIC LinkedIn post from your LinkedIn profile</strong> ({postedAs}) that publishes the LinkedIn event, and says:</p>
                    <blockquote>{p.ledger.commentary}</blockquote>
                    <div class="buttons">
                      <button type="submit">{dryRun ? "Run the dry run" : "Yes, post it on LinkedIn"}</button>
                      <button type="submit" formmethod="dialog" formnovalidate class="secondary">Cancel</button>
                    </div>
                  </form>
                </dialog>
              </>
            )}
            {p.ledger.status === "pending" && (
              <form method="post" action={`/admin/events/${date}/#linkedin-event`}>
                <input type="hidden" name="action" value="linkedin_allow_retry">
                <p>Check LinkedIn first: open the LinkedIn page's events as a page admin and look for this date's event
                  (an event that was never posted stays hidden from everyone else). If it's there, don't retry: ask for the ledger to be fixed.</p>
                <button type="submit" class="secondary">I checked: nothing was created, allow retry</button>
              </form>
            )}
          </div>
        )}

        {refusals.length > 0 && (
          <div class="refusals" role="alert">
            {!needsConfirm && <p><strong>{p.ledger ? "Not available:" : "Can't create the LinkedIn event:"}</strong></p>}
            <ul>{refusals.map((r) => <li data-refusal={r.code}>{r.message}</li>)}</ul>
            {result?.duplicates?.length > 0 && (
              <ul class="duplicates">
                {result.duplicates.map((d: any) => <li>{d.name ?? "(no name)"} <span class="muted">(LinkedIn event {d.id})</span></li>)}
              </ul>
            )}
          </div>
        )}

        {result?.ok && result.mode === "dry_run" && (
          <div class="result" role="status">
            <p><strong>Dry run: nothing was sent.</strong> These are the requests that would have been sent, in order.
              {result.duplicateCheck === "passed"
                ? " The duplicate check against the LinkedIn page's LinkedIn events passed."
                : result.duplicateCheck === "skipped" ? " The duplicate check was skipped: authenticate with LinkedIn to run it." : ""}</p>
            {result.image?.warnings?.map((w: string) => <p class="warn">{w}</p>)}
            <ol class="requests">
              {result.requests.map((q: any) => (
                <li>
                  <code>{q.method} {q.url}</code>
                  {typeof q.body === "string" ? <p class="muted">{q.body}</p> : <pre>{json(q.body)}</pre>}
                </li>
              ))}
            </ol>
          </div>
        )}

        {p.spec && (
          <>
            <h3>Preview</h3>
            <dl class="preview">
              <dt>Name</dt><dd>{p.spec.name}</dd>
              <dt>Description</dt><dd>{p.spec.description}</dd>
              <dt>When</dt><dd>{when}</dd>
              <dt>Address</dt><dd>{address}</dd>
              <dt>Venue details</dt><dd>{p.spec.venueDetails}</dd>
              <dt>External link</dt><dd><a href={EXTERNAL_URL} rel="noopener noreferrer">{EXTERNAL_URL}</a></dd>
              <dt>Visibility</dt><dd>LISTED (public, discoverable), organized by the LinkedIn page</dd>
              <dt>16:9 Event Image</dt>
              <dd>
                {image16x9Src ? <img src={image16x9Src} alt="The 16:9 Event Image" width="320" height="180" loading="lazy"> : <span class="muted">Not available</span>}
                <span class="muted"> {SOURCE[p.image.source] ?? p.image.source}{image16x9 && "path" in image16x9 ? ` (${image16x9.path})` : ""}</span>
              </dd>
              <dt>Post commentary</dt><dd><blockquote>{p.spec.commentary}</blockquote></dd>
              <dt>Posted as</dt><dd>{postedAs}</dd>
            </dl>
            <details>
              <summary>Payloads</summary>
              <p class="muted">Values in angle brackets come from LinkedIn's replies.</p>
              <h4>Image upload</h4><pre>{json(p.payloads.imageUpload)}</pre>
              <h4>Event</h4><pre>{json(p.payloads.event)}</pre>
              <h4>Post</h4><pre>{json(p.payloads.post)}</pre>
            </details>
          </>
        )}

        {canCreate && (
          <>
            <form method="post" action={`/admin/events/${date}/#linkedin-event`}>
              <input type="hidden" name="action" value="linkedin_create">
              <button type="submit" data-linkedin-open="linkedin-confirm">Create live event</button>
            </form>
            <dialog id="linkedin-confirm" aria-labelledby="linkedin-confirm-title" open={needsConfirm}>
              <form method="post" action={`/admin/events/${date}/#linkedin-event`}>
                <input type="hidden" name="action" value="linkedin_create">
                <input type="hidden" name="confirm" value="live">
                <h3 id="linkedin-confirm-title">Create the LinkedIn event?</h3>
                {needsConfirm && <p class="muted">Confirm here to go ahead.</p>}
                {dryRun && <p class="dry"><strong>Dry run: nothing will be sent.</strong></p>}
                <dl>
                  <dt>Date</dt><dd>{longDay(date)}</dd>
                  <dt>Title</dt><dd>{p.spec.name}</dd>
                  <dt>Visibility</dt><dd>LISTED (public)</dd>
                  <dt>Posted by</dt><dd>{postedAs}</dd>
                </dl>
                <p>This creates a <strong>REAL public LinkedIn event</strong> hosted by the LinkedIn page, and a <strong>PUBLIC LinkedIn post from your LinkedIn profile</strong> ({postedAs}) that says:</p>
                <blockquote>{p.spec.commentary}</blockquote>
                <div class="buttons">
                  <button type="submit">{dryRun ? "Run the dry run" : "Yes, create it on LinkedIn"}</button>
                  <button type="submit" formmethod="dialog" formnovalidate class="secondary">Cancel</button>
                </div>
              </form>
            </dialog>
          </>
        )}
        {(canCreate || canPublish) && <script is:inline type="module" src="/js/admin-linkedin.js"></script>}
      </>
    )}
  </div>
)}

<style>
  .mode { padding: 0.4rem 0.75rem; border-left: 3px solid var(--line); }
  .mode-live { border-left-color: var(--err); font-weight: 600; }
  .refusals { border-left: 3px solid var(--err); padding: 0.1rem 0.75rem; }
  .refusals ul { margin: 0.25rem 0; }
  .preview { display: grid; grid-template-columns: max-content 1fr; gap: 0.3rem 1rem; }
  .preview dt { font-weight: 600; }
  .preview dd { margin: 0; overflow-wrap: anywhere; }
  .preview img { display: block; max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: 4px; }
  blockquote { margin: 0.25rem 0; padding-left: 0.75rem; border-left: 3px solid var(--line); }
  pre { overflow-x: auto; padding: 0.5rem; border: 1px solid var(--line); border-radius: 4px; font-size: 0.85rem; }
  .requests code { overflow-wrap: anywhere; }
  dialog { max-width: 36rem; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: inherit; }
  dialog[open]:not(:modal) { position: static; margin: 1rem 0; }
  dialog dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.2rem 1rem; }
  dialog dt { font-weight: 600; }
  dialog dd { margin: 0; }
  .buttons { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .warn { color: var(--err); }
</style>
