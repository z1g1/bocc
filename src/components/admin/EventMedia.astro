---
// Photos for one event on /admin/events/YYYY-MM-DD (ADR 0010). Admin only: anyone
// else gets nothing rendered (the `social` role reads media through the Phase 5 work
// order, ADR 0008). Props are stable for the event page:
//   <EventMedia date="2026-11-24" />
//
// - Two sections, "Sign-in board" and "Photos from Event" (kind event_photo, named social_photo until #54; the label
//   was "Social photos" until ADR 0012), each with its own upload form
//   (kind fixed by a hidden field), status line, gallery and unfinished uploads. No
//   "OK to use publicly" control: every photo from the event is covered by the posted photo
//   waiver, so the server marks it publicly usable (ADR 0010 decision 2).
// - Upload forms: /js/admin-media.js makes the 1600px display copy and the 400px
//   thumbnail in the browser and PUTs all three files straight to the private bucket
//   (presigned URLs from /api/admin/media/uploads). Hidden until that script runs.
// - Gallery: `ready` photos, thumbnails through short-lived presigned GETs (re-signed
//   on every render); the thumbnail links to the display copy, plus the original.
// - Unfinished uploads (pending over a day) listed with a delete button. No cron.
// - Storage not configured: a message, no upload UI, no gallery.
import { hasRole } from "../../lib/admin/roles.mjs";
import { getStorage, isIsoDate } from "../../lib/admin/storage.mjs";
import { STORAGE_OFF_MESSAGE } from "../../lib/admin/media-http.mjs";
import { inUseMessage } from "../../lib/admin/event-image-rules.mjs";

interface Props {
  /** The event's date, YYYY-MM-DD. */
  date: string;
}
const { date } = Astro.props;
const allowed = hasRole(Astro.locals, "admin") && isIsoDate(date);
const { storage } = allowed ? getStorage() : { storage: null };

const NOTICES: Record<string, string> = {
  deleted: "Photo deleted.",
  "deleted-partial": "Photo deleted. Some of its files couldn't be removed from storage; they are logged for cleanup.",
};
// A refused delete names the events that use the photo as their Event Image (ticket
// #21): ?media=in-use&used-by=<date,…>, each date checked before it is shown.
const usedBy = (Astro.url.searchParams.get("used-by") ?? "").split(",").filter((d) => isIsoDate(d));
const mediaParam = Astro.url.searchParams.get("media") ?? "";
const notice = mediaParam === "in-use" && usedBy.length ? inUseMessage(usedBy) : NOTICES[mediaParam] ?? null;

// One section per kind, each with its own upload form (the kind is fixed: a hidden
// `kind` field), status line and gallery.
const SECTIONS = [
  {
    kind: "signin_board", slug: "signin", heading: "Sign-in board", label: "Sign-in board",
    empty: "No sign-in board photo yet.",
    pickLabel: "Sign-in board photos (JPEG or PNG)", button: "Upload sign-in board photos",
  },
  {
    kind: "event_photo", slug: "social", heading: "Photos from Event", label: "Photo from Event",
    empty: "No photos from the event yet.",
    pickLabel: "Photos from Event (JPEG or PNG)", button: "Upload photos from the event",
  },
] as const;

let ready: any[] = [];
let pending: any[] = [];
if (allowed && storage) {
  const { listEventMedia } = await import("../../lib/admin/media.mjs");
  const { pool } = await import("../../lib/admin/db.mjs");
  const media = await listEventMedia(pool, date);
  ready = media.ready.map((m: any) => ({
    ...m,
    thumbUrl: storage.presignGet({ key: m.thumbKey }).url,
    displayUrl: storage.presignGet({ key: m.displayKey }).url,
    originalUrl: storage.presignGet({
      key: m.originalKey,
      downloadName: `bocc-${date}-${m.kind}-${String(m.id).slice(0, 8)}.${m.originalKey.split(".").pop()}`,
    }).url,
  }));
  pending = media.pending;
}
const sections = SECTIONS.map((s) => {
  const mine = pending.filter((m) => m.kind === s.kind);
  const stale = mine.filter((m) => m.stale);
  return {
    ...s,
    ready: ready.filter((m) => m.kind === s.kind),
    stale,
    recent: mine.length - stale.length,
    statusId: `media-status-${s.slug}-${date}`,
    inputId: `media-files-${s.slug}-${date}`,
    headingId: `h-media-${s.slug}`,
  };
});
const fmtTime = (d: Date) =>
  new Intl.DateTimeFormat("en-US", { timeZone: "America/New_York", dateStyle: "medium", timeStyle: "short" }).format(d);
---
{allowed && (
  <div class="event-media" id="event-media" data-event-date={date}>
    {notice && <p class="notice" role="status">{notice}</p>}
    {!storage ? (
      <section aria-labelledby="h-media">
        <h2 id="h-media">Photos</h2>
        <p class="muted" data-media-off>{STORAGE_OFF_MESSAGE}</p>
      </section>
    ) : (
      <>
        {sections.map((s) => (
          <section class="media-section" id={`media-${s.slug}`} aria-labelledby={s.headingId} data-media-kind={s.kind}>
            <h2 id={s.headingId}>{s.heading}</h2>
            <p class="muted" data-media-nojs>Uploading photos needs JavaScript.</p>
            <form class="media-upload" data-media-upload data-kind={s.kind} data-event-date={date} data-status={s.statusId} hidden>
              <input type="hidden" name="kind" value={s.kind}>
              <label for={s.inputId}>{s.pickLabel}</label>
              <input id={s.inputId} type="file" name="files" accept="image/jpeg,image/png" multiple required>
              <button type="submit">{s.button}</button>
            </form>
            <p class="media-status" id={s.statusId} role="status" aria-live="polite"></p>

            {s.ready.length === 0 ? <p class="muted">{s.empty}</p> : (
              <ul class="media-grid">
                {s.ready.map((m: any, i: number) => (
                  <li>
                    <a href={m.displayUrl}><img src={m.thumbUrl} alt={`${s.label}${s.ready.length > 1 ? ` ${i + 1} of ${s.ready.length}` : ""}, ${date}`} loading="lazy" decoding="async"></a>
                    <p><a href={m.originalUrl} download>Download original</a></p>
                    <div class="media-actions">
                      <form method="post" action={`/api/admin/media/${m.id}/delete`} class="inline" data-confirm="Delete this photo? This can't be undone.">
                        <button type="submit" class="small secondary">Delete</button>
                      </form>
                    </div>
                  </li>
                ))}
              </ul>
            )}

            {s.recent > 0 && <p class="muted">{s.recent} upload{s.recent === 1 ? "" : "s"} in progress or unfinished (less than a day old).</p>}
            {s.stale.length > 0 && (
              <div class="media-stale">
                <h3>Unfinished uploads</h3>
                <p class="muted">Started over a day ago and never completed. Delete them to tidy up.</p>
                <ul class="plain">
                  {s.stale.map((m: any) => (
                    <li>
                      <span>{s.label}, started {fmtTime(m.createdAt)}</span>
                      <form method="post" action={`/api/admin/media/${m.id}/delete`} class="inline" data-confirm="Delete this unfinished upload?">
                        <button type="submit" class="small secondary">Delete</button>
                      </form>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        ))}
        <script is:inline type="module" src="/js/admin-media.js"></script>
      </>
    )}
  </div>
)}

<style>
  .media-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 1rem; }
  .media-grid li { margin: 0; }
  .media-grid img { display: block; width: 100%; height: auto; min-height: 3rem; border: 1px solid var(--line); border-radius: 4px; }
  .media-grid p { margin: 0.25rem 0; font-size: 0.875rem; }
  .media-actions { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .media-status { min-height: 1.5em; }
</style>
