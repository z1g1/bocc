---
// Compact charcoal page hero with an optional "at a glance" card.
// Used by the Page layout and the event pages.
import Icon from "./Icon.astro";
import Actions from "./Actions.astro";
interface Props { eyebrow?: string; heading: string; summary?: string; actions?: any[]; glance?: { value: string; label: string }[] }
const { eyebrow, heading, summary, actions, glance } = Astro.props;
---
<section class="page-hero sun-rays">
  <img class="page-hero__watermark" src="/assets/images/brand/web/bocc-badge-720.png" alt="" aria-hidden="true">
  <div class="container page-hero__grid">
    <div class="page-hero__lead">
      {eyebrow && (
        <span class="page-hero__badge">
          <Icon name="sunrise" size="16" />
          <span class="stamp">{eyebrow}</span>
        </span>
      )}
      <h1>{heading}</h1>
      {summary && <p class="page-hero__summary">{summary}</p>}
      {actions && <div class="page-hero__cta"><Actions actions={actions} /></div>}
      <slot name="cta" />
    </div>
    {glance && (
      <aside class="glance-card" aria-label="At a glance">
        <div class="sunrise-rule"></div>
        <div class="glance-card__body">
          <span class="stamp">At a glance</span>
          <dl class="glance-card__list">
            {glance.map((item) => (
              <div class="glance-card__row">
                <dt set:html={item.value} />
                <dd>{item.label}</dd>
              </div>
            ))}
          </dl>
        </div>
      </aside>
    )}
  </div>
</section>
