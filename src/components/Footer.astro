---
// Charcoal footer capped by a sunrise rule (port of _includes/footer.html).
import { data, site } from "../lib/data";
import { footerYear } from "../lib/time";
const nav = data("nav");
const s = site();
---
<footer class="site-footer">
  <div class="sunrise-rule"></div>
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <a class="site-header__logo" href="/" aria-label={`${nav.brand.name} — home`}>
        <img src="/assets/images/brand/web/bocc-mug-96.png" alt="" width="44" height="44">
        <span>{nav.brand.wordmark}</span>
      </a>
      <p>{nav.brand.tagline}</p>
      {nav.brand.funding && <p class="site-footer__funding">{nav.brand.funding}</p>}
    </div>

    <div class="site-footer__cols">
      <div class="site-footer__meta">
        <span class="stamp stamp--gold">When</span>
        <p>Every Tuesday<br>7:30&ndash;9:00&nbsp;AM</p>
      </div>
      <div class="site-footer__meta">
        <span class="stamp stamp--gold">Where</span>
        <p>{s.event.venue}<br>Lobby · Buffalo, NY</p>
      </div>
      <nav class="site-footer__nav" aria-label="Footer">
        <span class="stamp stamp--gold">Explore</span>
        <ul>
          {nav.footer.map((item: any) => <li><a href={item.url}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>

  <div class="container site-footer__legal">
    <div class="site-footer__legal-grid">
      <small>&copy; {footerYear()} {nav.brand.name} &middot; A program of {s.event.organizer} (501c3)</small>
      <ul class="site-footer__social" aria-label="Social media">
        {nav.social.map((item: any) => <li><a href={item.url} rel="me noopener">{item.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>
