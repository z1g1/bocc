---
// The public "Out of Coffee" 404 hero. Used by src/pages/404.astro (the static 404
// Netlify serves) and by the on-demand /events/YYYY-MM-DD/ page for a date with no
// event, so both say the same thing.
import Icon from "./Icon.astro";
---
<section class="hero sun-rays">
  <div class="container hero__inner">
    <span class="hero__badge">
      <Icon name="coffee" size="16" />
      <span class="stamp">Error 404</span>
    </span>
    <h1>This page is out of coffee.</h1>
    <p class="hero__lead">We couldn't find that page — the pot's empty here. There's a fresh one every Tuesday morning, though.</p>
    <div class="hero__cta">
      <a class="btn btn--primary btn--lg" href="/">Back to home<Icon name="arrow" size="18" /></a>
    </div>
  </div>
</section>
