---
// "No badges. No pitches. Just coffee." timeline. Data from src/data/home.yml (schedule).
import { data } from "../../lib/data";
const s = data("home").schedule;
---
<section class="schedule" aria-labelledby="schedule-heading">
  <div class="container">
    <div class="schedule__head">
      <span class="section-label">{s.eyebrow}</span>
      <h2 id="schedule-heading">{s.heading}</h2>
      <p>{s.intro}</p>
    </div>
    <div class="schedule__card">
      <div class="sunrise-rule"></div>
      {s.rows.map((row: any) => (
        <div class="schedule__row">
          <div class="schedule__time">{row.time}</div>
          <div>
            <div class="schedule__title">{row.title}</div>
            <div class="schedule__body">{row.body}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
