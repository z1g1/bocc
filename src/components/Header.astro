---
// Sticky charcoal nav (port of _includes/header.html). Data from src/data/nav.yml.
// The current page gets aria-current="page", which also drives the gold highlight.
import Icon from "./Icon.astro";
import { data } from "../lib/data";
interface Props { url: string }
const nav = data("nav");
const { url } = Astro.props;
---
<header class="site-header">
  <div class="container site-header__bar">
    <a class="site-header__logo" href="/" aria-label={`${nav.brand.name} — home`}>
      <img src="/assets/images/brand/web/bocc-mug-96.png" alt="" width="40" height="40">
      <span>{nav.brand.wordmark}</span>
    </a>

    <button type="button" class="site-nav__toggle" data-nav-toggle aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
      <span class="site-nav__toggle-open"><Icon name="menu" size="24" /></span>
      <span class="site-nav__toggle-close"><Icon name="close" size="24" /></span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Primary" data-nav>
      <ul class="site-nav__list">
        {nav.primary.map((item: any) => (
          <li><a href={item.url} aria-current={url === item.url ? "page" : undefined}>{item.label}</a></li>
        ))}
        <li><a class="btn btn--primary btn--sm" href={nav.cta.url}>{nav.cta.label}</a></li>
      </ul>
    </nav>
  </div>
</header>
