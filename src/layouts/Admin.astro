---
// Minimal shell for /login/ and /admin/* (ADR 0008). Deliberately separate from
// Default.astro: no Google Analytics, no site header/footer, no third-party origins,
// noindex. The CSP is also sent as a header by src/middleware.ts; frame-ancestors
// only works as a header, so the meta copy leaves it out. The CSS lives in
// src/lib/admin/error-page.mjs, shared with the 403/404 pages the middleware sends.
import { adminCsp } from "../lib/admin/headers.mjs";
import { storageOrigin } from "../lib/admin/storage.mjs";
import { ADMIN_CSS } from "../lib/admin/error-page.mjs";
interface Props {
  title: string;
  /** Pass Astro.locals.user on signed-in pages to show the nav and sign-out button. */
  user?: { email: string; name: string };
  roles?: string[];
  /** Wider main column, for the data tables. */
  wide?: boolean;
}
const { title, user, roles = [], wide = false } = Astro.props;
const csp = adminCsp({ dev: import.meta.env.DEV, mediaOrigin: storageOrigin() }).replace("frame-ancestors 'none'; ", "");
---
<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="same-origin">
    <meta http-equiv="Content-Security-Policy" content={csp}>
    <title>{title} · BOCC admin</title>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <style is:inline set:html={ADMIN_CSS}></style>
  </head>
  <body>
    <header class="bar">
      <a class="brand" href="/admin/">BOCC admin</a>
      {user && (
        <nav>
          <a href="/admin/">Home</a>
          <a href="/admin/account/">Account</a>
          <form method="post" action="/logout">
            <button type="submit" class="link">Sign out</button>
          </form>
        </nav>
      )}
    </header>
    <main class:list={{ wide }}>
      <slot />
    </main>
    {user && <footer>Signed in as {user.email}{roles.length > 0 && ` (${roles.join(", ")})`}</footer>}
  </body>
</html>

