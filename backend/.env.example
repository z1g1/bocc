# Environment contract for the BOCC backend.
# Read and validated in one place: netlify/functions/utils/config.js
# Missing any REQUIRED secret makes the functions fail fast at cold start.

# --- REQUIRED secrets -------------------------------------------------------
# The POOLED Neon connection string for the least-privilege `checkin_writer`
# role — NEVER neondb_owner. Any sslmode param is stripped in code; TLS is always
# verify-full. See docs/backend/NEON_PERMISSIONS.md.
#   postgresql://checkin_writer:<password>@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb
CHECKIN_DB_URL=

# --- OPTIONAL (have defaults; override per environment) ----------------------
# CORS: set to your frontend domain in production (e.g. "https://716coffee.club").
# Defaults to "*" if not set.
ALLOWED_ORIGIN=*

# Pool size per function instance (serverless). Defaults to 1.
# DB_POOL_MAX=1
# Optional PEM CA override (Neon certs are publicly trusted; normally unset).
# DB_CA_CERT=

# --- Test-only --------------------------------------------------------------
# Token for smoke tests
TEST_TOKEN=test-smoke-token
