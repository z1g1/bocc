{
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "airtable": "^0.12.2",
    "jest": "^29.7.0"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/tests/jest.setup.js"
    ]
  },
  "scripts": {
    "test": "jest",
    "test:smoke-local": "bash tests/start-local-test.sh",
    "test:smoke-prod": "API_URL=https://716coffee.club/.netlify/functions/checkin bash tests/smoke-test.sh",
    "migrate": "node --env-file=../.env.local scripts/migrate.js",
    "migrate:status": "node --env-file=../.env.local scripts/migrate.js --status",
    "backfill": "node --env-file=../.env.backfill scripts/backfill-from-airtable.js",
    "backfill:dry": "node --env-file=../.env.backfill scripts/backfill-from-airtable.js --dry-run",
    "backfill:verify": "node --env-file=../.env.backfill scripts/backfill-from-airtable.js --verify"
  }
}
